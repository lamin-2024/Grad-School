module SIPO_Block (
    input wire DCLK,            // Data clock
    input wire CLR,             // Clear input
    input wire EN,              // Enable signal
    input wire DATA_IN,         // Serial data input (1-bit at a time)

    output reg [15:0] PDATA_IN_L,  // Parallel output Left
    output reg [15:0] PDATA_IN_R   // Parallel output Right
);

    reg [7:0] shift_reg = 8'b0;  // Temporary register to store 8 bits
    reg [2:0] bit_count = 3'b0;  // To count 8 bits

    always @(posedge DCLK or posedge CLR) begin
        if (CLR) begin
            shift_reg     <= 8'b0;
            bit_count     <= 3'b0;
            PDATA_IN_L    <= 16'b0;
            PDATA_IN_R    <= 16'b0;
        end
        else if (EN) begin
            shift_reg <= {shift_reg[6:0], DATA_IN};  // Shift left and load new bit
            bit_count <= bit_count + 1;

            if (bit_count == 3'd7) begin  // 8th bit just loaded
                PDATA_IN_L <= {shift_reg[7:4], 12'b0};  // Left: upper nibble
                PDATA_IN_R <= {shift_reg[3:0], 12'b0};  // Right: lower nibble
                bit_count  <= 3'b0;  // Reset for next 8-bit word
            end
        end
    end

endmodule
