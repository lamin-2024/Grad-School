[05/05 22:20:18    554s] ############################################################################
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::StartRVE {cmd {params ""}} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	append cmd " -gui -rve $params"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {[catch {set fid [open "| $cmd" "r+"]} emsg]==0} {
[05/05 22:20:18    554s] 		fconfigure $fid -buffering line -blocking 0
[05/05 22:20:18    554s] 		fileevent $fid readable "mgc_enc::ReadRVE $fid"
[05/05 22:20:18    554s] 		lappend vars(rve_fids) $fid
[05/05 22:20:18    554s] 		return $fid
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		return ""
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::ReadRVE {fid} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	read $fid
[05/05 22:20:18    554s] 	if {[eof $fid]} {
[05/05 22:20:18    554s] 		close $fid
[05/05 22:20:18    554s] 		set fid_index [lsearch $vars(rve_fids) $fid]
[05/05 22:20:18    554s] 		if {$fid_index!=-1} {
[05/05 22:20:18    554s] 			set vars(rve_fids) [lreplace $vars(rve_fids) $fid_index $fid_index]
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CheckRVE {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	if {[info exists vars(rve_fids)] && [llength $vars(rve_fids)]!=0} {
[05/05 22:20:18    554s] 		return [lindex $vars(rve_fids) 0]
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return ""
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::runRVE {{params ""}} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set fid [CheckRVE]
[05/05 22:20:18    554s] 	if {$fid!=""} {
[05/05 22:20:18    554s] 		if {![uimessage_YesNo . "RVE is already running!\nDo you want to start another session?"]} {
[05/05 22:20:18    554s] 			puts $fid rve_PopWindows
[05/05 22:20:18    554s] 			flush $fid
[05/05 22:20:18    554s] 			return 1
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set cmd [CheckEnv]
[05/05 22:20:18    554s] 	if {$cmd==""} {return 0}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set fid [StartRVE $cmd $params]
[05/05 22:20:18    554s] 	if {$fid==""} {return 0}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::openRDBFileInRVE {rdbFileName} {
[05/05 22:20:18    554s]     if {[CheckRVE] eq ""} {
[05/05 22:20:18    554s]         runRVE $rdbFileName
[05/05 22:20:18    554s]     } else {
[05/05 22:20:18    554s]         SendCmdToClient rve_open_rdb_file $rdbFileName
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::openDBInRVE {dbName {topCell ""}} {
[05/05 22:20:18    554s]     if {[CheckRVE] eq ""} {
[05/05 22:20:18    554s]         runRVE "$dbName $topCell"
[05/05 22:20:18    554s]     } else {
[05/05 22:20:18    554s]         set cmd [list rve_open_db $dbName]
[05/05 22:20:18    554s]         if {$topCell ne ""} {
[05/05 22:20:18    554s]             lappend cmd $topCell
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         eval SendCmdToClient $cmd
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::runCalibre {prog} {
[05/05 22:20:18    554s]     if {[DesignLoaded 1]} {
[05/05 22:20:18    554s]         if [string match "AUTOFIX" $prog] {
[05/05 22:20:18    554s]             set cmd calibre_autofix
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             if {$prog eq "RVE"} {
[05/05 22:20:18    554s]                 set param ""
[05/05 22:20:18    554s]             } else {
[05/05 22:20:18    554s]                 set param [getCellName [getTopCell]]
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]             set cmd "mgc_enc::run${prog} $param"
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         eval $cmd
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::setupExport {type} {
[05/05 22:20:18    554s] 	SetExportOptions $type 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::SetExportOptionsCancel {w type} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(showDlgRunTimeTmp$type) $vars(showDlgRunTime$type)
[05/05 22:20:18    554s] 	set vars(exportDlgStatus) 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::SetExportOptionsOK {w type txt} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(exportDlgStatus) 1
[05/05 22:20:18    554s] 	set vars(showDlgRunTime$type) $vars(showDlgRunTimeTmp$type)
[05/05 22:20:18    554s] 	set vars(exportOptions$type) [string trim [$txt get 1.0 end]]
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::SaveRVELayerPreference {w} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set types { {{Tcl Script} {.tcl}} {{All Files} *} }
[05/05 22:20:18    554s] 	set fName [tk_getSaveFile -filetypes $types]
[05/05 22:20:18    554s] 	if { $fName=="" } { return 0 }
[05/05 22:20:18    554s] 	if {[catch {set fp [open $fName w]}]} {
[05/05 22:20:18    554s] 		uimessage_Error $w "Could not open layer preference file $fName"
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	for {set i 0} {$i<16} {incr i} {
[05/05 22:20:18    554s] 		set width 1
[05/05 22:20:18    554s] 		if { [string is integer -strict $vars(rve_${i}_width)] } {
[05/05 22:20:18    554s] 			set width $vars(rve_${i}_width)
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		set stipple [string tolower $vars(rve_${i}_pattern)]
[05/05 22:20:18    554s] 		if { $stipple=="other" } {
[05/05 22:20:18    554s] 			set stipple [getLayerPreference rve_$i -stipple]
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		set visible [getLayerPreference rve_$i -isVisible]
[05/05 22:20:18    554s] 		set sLine "setLayerPreference rve_$i -color $vars(rve_${i}_color) -isVisible $visible -isSelectable $vars(rve_${i}_selectable) -lineWidth $width"
[05/05 22:20:18    554s] 		if { $stipple=="" || $stipple=="none" } {
[05/05 22:20:18    554s] 			set stipple [getLayerPreference rve_$i -stippleData] 
[05/05 22:20:18    554s] 			if { $stipple!="" } { append sLine " -stippleData $stipple" }
[05/05 22:20:18    554s] 		} else {
[05/05 22:20:18    554s] 			append sLine " -stipple $stipple"
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		puts $fp $sLine
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	close $fp
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::SetupRVECancel {w} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	set vars(setupRVEStatus) 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::SetupRVEOK {w} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	set vars(setupRVEStatus) 1
[05/05 22:20:18    554s] 	for {set i 0} {$i<16} {incr i} {
[05/05 22:20:18    554s] 		set width 1
[05/05 22:20:18    554s] 		if { [string is integer -strict $vars(rve_${i}_width)] } {
[05/05 22:20:18    554s] 			set width $vars(rve_${i}_width)
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		set stipple [string tolower $vars(rve_${i}_pattern)]
[05/05 22:20:18    554s] 		if { $stipple!="other" } {
[05/05 22:20:18    554s] 			setLayerPreference rve_$i -stipple $stipple
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		setLayerPreference rve_$i -color $vars(rve_${i}_color) -isSelectable $vars(rve_${i}_selectable) -lineWidth $width
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::SetupSocketCancel {w} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	set vars(setupSocketStatus) 0
[05/05 22:20:18    554s] 	set vars(tmp_socket_number) $vars(socket_number)
[05/05 22:20:18    554s] 	set vars(tmp_socket_host) $vars(socket_host)
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::SetupSocketOK {w} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set portNum $vars(tmp_socket_number)
[05/05 22:20:18    554s] 	set host $vars(tmp_socket_host)
[05/05 22:20:18    554s] 	if { [string is integer -strict $portNum] && $portNum>=-1 && $portNum<=65535 } {
[05/05 22:20:18    554s] 		set vars(setupSocketStatus) 1
[05/05 22:20:18    554s] 		if { $portNum!=-1 } {
[05/05 22:20:18    554s] 			if { [mgc_enc::initServerSocket $portNum $host] } {
[05/05 22:20:18    554s] 				set vars(socket_number) $portNum
[05/05 22:20:18    554s] 				set vars(socket_host) $host
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		uimessage_Error . "Socket port number must be an integer between -1 and 65535."
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] # DR 1362158 Setup commands (RVE, Export GDS, Export Verilog, etc) not working in Innovus Common UI mode.  Avoid 'update' or 'update idle'
[05/05 22:20:18    554s] @proc mgc_enc::WaitForUpdate {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	set ::mgc_enc::vars(waitUpdateVar) 0
[05/05 22:20:18    554s] 	after idle [list set ::mgc_enc::vars(waitUpdateVar) 1]
[05/05 22:20:18    554s] 	while { !$::mgc_enc::vars(waitUpdateVar) } {
[05/05 22:20:18    554s] 		tkwait variable ::mgc_enc::vars(waitUpdateVar)
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::AddFrameLabel {f text {center 0} {fg ""} {bg ""}} {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]    if ![winfo exists $f] {frame $f}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]    set p [winfo parent $f]
[05/05 22:20:18    554s]    set p_bg [$p cget -bg] ;# get parent's background so we can match it
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]    # Figure out the widget handle to create so it will be unique
[05/05 22:20:18    554s]    set i 1
[05/05 22:20:18    554s]    while 1 {
[05/05 22:20:18    554s]       if ![winfo exists $p.frameLABEL__$i] { break }
[05/05 22:20:18    554s]       incr i
[05/05 22:20:18    554s]    }
[05/05 22:20:18    554s]    # A pady of "1" is VERY important because it prevents labeled frames
[05/05 22:20:18    554s]    # in TK4.2 from having the top pixel row of the label cropped.
[05/05 22:20:18    554s]    # We use extra spaces around the text to provide padding between
[05/05 22:20:18    554s]    # the text and the 3D exterior of the frame.
[05/05 22:20:18    554s]    set lbl [label "$p.frameLABEL__$i" -pady 1 -text " $text "]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]    if {$bg == ""} { set bg $p_bg }
[05/05 22:20:18    554s]    if {$fg == ""} {
[05/05 22:20:18    554s]       # Check if there's a default stored in the options database
[05/05 22:20:18    554s]       set fg [option get $lbl frameLabelFG Color]
[05/05 22:20:18    554s]    }
[05/05 22:20:18    554s]    if {$fg != ""} { set fg "-fg $fg" }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]    # Set the label's background and foreground colors
[05/05 22:20:18    554s]    eval $lbl conf -bg "$bg" "$fg"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]    # Check if label has one or two lines
[05/05 22:20:18    554s]    if {[llength [split $$text "\n"]] == 1} {
[05/05 22:20:18    554s]       set Y "-14"
[05/05 22:20:18    554s]    } else {
[05/05 22:20:18    554s]       set Y "-20"
[05/05 22:20:18    554s]    }
[05/05 22:20:18    554s]    if $center {
[05/05 22:20:18    554s]       place $lbl -in $f -relx .5 -y $Y -anc n
[05/05 22:20:18    554s]    } else {
[05/05 22:20:18    554s]       place $lbl -in $f -x 5 -y $Y
[05/05 22:20:18    554s]    }
[05/05 22:20:18    554s]    return $lbl
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::SetExportOptions {type run_time} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	append w .calibreExportOptionsDlg $type
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set txt $w.top.opts.txt
[05/05 22:20:18    554s] 	set mode_f $w.top.mode
[05/05 22:20:18    554s] 	set btns_f $w.top.btns
[05/05 22:20:18    554s] 	if {[winfo exists $w] == 0} {
[05/05 22:20:18    554s] 		toplevel $w
[05/05 22:20:18    554s] 		wm title $w "Calibre $type Export Options"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		# Set the dialog up so that its width and height are resizable
[05/05 22:20:18    554s] 		wm resizable $w 1 1
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		wm withdraw $w
[05/05 22:20:18    554s] 		wm protocol $w WM_DELETE_WINDOW "mgc_enc::SetExportOptionsCancel $w $type"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		frame $w.top
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		pack [frame $w.top.sp1] -pady 2m -padx 2m
[05/05 22:20:18    554s]                 
[05/05 22:20:18    554s] 		pack [frame $w.top.opts -relief groove -bd 2] -pady 2m -expand yes -fill both -padx 2m -side top
[05/05 22:20:18    554s] 		set options_f $w.top.opts
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		set cmd_name ""
[05/05 22:20:18    554s] 		switch $type {
[05/05 22:20:18    554s] 			"GDS"       { set cmd_name "streamOut" }
[05/05 22:20:18    554s] 			"DEF"       { set cmd_name "defOut" }	    ;# write_def
[05/05 22:20:18    554s] 			"Verilog"   { set cmd_name "saveNetlist" }  ;# write_netlist
[05/05 22:20:18    554s] 			default     { }
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		AddFrameLabel $options_f "Options for the \"$cmd_name\" command:" 0 
[05/05 22:20:18    554s] 		pack [text $options_f.txt -wrap word -height 5 -width 60] -side top -expand yes -fill both -padx 1m -pady 1.2m
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		bind $w <Escape> "mgc_enc::SetExportOptionsCancel $w $type"
[05/05 22:20:18    554s] 		bind $w <Return> "mgc_enc::SetExportOptionsOK $w $type $txt"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		frame $mode_f
[05/05 22:20:18    554s] 		checkbutton $mode_f.show_at_runtime -var mgc_enc::vars(showDlgRunTimeTmp$type) -text "Show dialog before export"
[05/05 22:20:18    554s] 		label $mode_f.label -pady 1 -text "File:"
[05/05 22:20:18    554s] 		entry $mode_f.entry -textvariable mgc_enc::vars(exportFileName) -state disabled
[05/05 22:20:18    554s] 		pack $mode_f -pady 0.5m -padx 2m -anchor s -fill x 
[05/05 22:20:18    554s] 		
[05/05 22:20:18    554s] 		frame $btns_f -relief raised -bd 1 
[05/05 22:20:18    554s] 		pack $btns_f -side bottom -fill x -anchor s
[05/05 22:20:18    554s] 		button $btns_f.ok -width 7 -text "OK" -command "mgc_enc::SetExportOptionsOK $w $type $txt"
[05/05 22:20:18    554s] 		button $btns_f.cancel -width 7 -text "Cancel" -command "mgc_enc::SetExportOptionsCancel $w $type"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	
[05/05 22:20:18    554s] 		pack $btns_f.ok -expand 1 -padx 5m -pady 2m -side left
[05/05 22:20:18    554s] 		pack $btns_f.cancel -expand 1 -padx 5m -pady 2m -side left
[05/05 22:20:18    554s] 		
[05/05 22:20:18    554s] 		focus $btns_f.ok
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		pack $w.top -side top -fill both -expand yes
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		#uiprocs_PositionWindow $w . "center"
[05/05 22:20:18    554s] 		mgc_enc::PositionWindowOnRight $w
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(showDlgRunTimeTmp$type) $vars(showDlgRunTime$type)
[05/05 22:20:18    554s] 	if {$run_time} {
[05/05 22:20:18    554s] 		pack forget $mode_f.show_at_runtime
[05/05 22:20:18    554s] 		pack $mode_f.label -pady 1  -anchor w -side left
[05/05 22:20:18    554s] 		pack $mode_f.entry -anchor e -side right -expand yes -fill x
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		pack forget $mode_f.label 
[05/05 22:20:18    554s] 		pack forget $mode_f.entry 
[05/05 22:20:18    554s] 		pack $mode_f.show_at_runtime -pady 0.5 -expand yes -fill x -padx 2m
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	$txt delete 1.0 end
[05/05 22:20:18    554s] 	$txt insert end $vars(exportOptions$type)
[05/05 22:20:18    554s] 	set insert_line [$txt get "insert linestart" "insert lineend"]
[05/05 22:20:18    554s] 	if {[string equal "" $insert_line]} {
[05/05 22:20:18    554s] 	# If insert cursor is at the beginning of an empty line, move it to
[05/05 22:20:18    554s] 	# the end of the previous one.
[05/05 22:20:18    554s] 		set idx [$txt index "end - 1 char"]
[05/05 22:20:18    554s] 		set row_count [lindex [split $idx .] 0]
[05/05 22:20:18    554s] 		if {$row_count > 1} {
[05/05 22:20:18    554s] 			set insert_row [expr {$row_count - 1}]
[05/05 22:20:18    554s] 			$txt mark set insert $insert_row.end
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	wm transient $w .
[05/05 22:20:18    554s] 	wm deiconify $w
[05/05 22:20:18    554s] 	mgc_enc::WaitForUpdate
[05/05 22:20:18    554s] 	raise $w
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	# wait for return value to be set after grabbing focus
[05/05 22:20:18    554s] 	grab set $w
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	tkwait variable mgc_enc::vars(exportDlgStatus)
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	grab release $w   ;# Make sure we let go of grab
[05/05 22:20:18    554s] 	wm withdraw $w    ;# To allow reuse we just hide window
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return $mgc_enc::vars(exportDlgStatus)
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::setupRVE {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	append w .calibreSetupRVE
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set btns_f $w.top.btns
[05/05 22:20:18    554s] 	if {[winfo exists $w] == 0} {
[05/05 22:20:18    554s] 		toplevel $w
[05/05 22:20:18    554s] 		wm title $w "Calibre Setup RVE Highlight Layers"
[05/05 22:20:18    554s] 		# Set the dialog up so that its width and height are resizable
[05/05 22:20:18    554s] 		wm resizable $w 1 1
[05/05 22:20:18    554s] 		wm withdraw $w
[05/05 22:20:18    554s] 		wm protocol $w WM_DELETE_WINDOW "mgc_enc::SetupRVECancel $w"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		frame $w.top
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		bind $w <Escape> "mgc_enc::SetupRVECancel $w"
[05/05 22:20:18    554s] 		bind $w <Return> "mgc_enc::SetupRVEOK $w"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		set options_f [frame $w.top.opts -relief groove -bd 2]
[05/05 22:20:18    554s] 		set pref_f [frame $options_f.pref_f]
[05/05 22:20:18    554s] 		label $pref_f.title_0 -pady 1 -text "Layer" -anchor w
[05/05 22:20:18    554s] 		label $pref_f.title_1 -pady 1 -text "Color" -anchor center
[05/05 22:20:18    554s] 		label $pref_f.title_2 -pady 1 -text "Stipple" -width 7 -anchor center
[05/05 22:20:18    554s] 		label $pref_f.title_3 -pady 1 -text "Selectable" -anchor center
[05/05 22:20:18    554s] 		label $pref_f.title_4 -pady 1 -text "Width" -width 3 -anchor center
[05/05 22:20:18    554s] 		grid $pref_f.title_0 $pref_f.title_1 $pref_f.title_2 $pref_f.title_3 $pref_f.title_4 -sticky nsew
[05/05 22:20:18    554s] 		grid columnconfigure $pref_f 0 -weight 1
[05/05 22:20:18    554s] 		set bg [$w cget -background]
[05/05 22:20:18    554s] 		for {set i 0} {$i<16} {incr i} {
[05/05 22:20:18    554s] 			label $pref_f.label_$i -text "rve_$i" -anchor w
[05/05 22:20:18    554s] 			frame $pref_f.color_$i -width 24p -height 24p -borderwidth 0
[05/05 22:20:18    554s] 			set c [canvas $pref_f.color_$i.c -height 24 -width 24 -borderwidth 0]
[05/05 22:20:18    554s] 			pack $c -fill none -expand 0
[05/05 22:20:18    554s] 			menubutton $pref_f.pattern_$i -menu $pref_f.pattern_$i.menu -width 7 -relief raised -bd 2 -anchor center -indicatoron 1 -textvariable mgc_enc::vars(rve_${i}_pattern)
[05/05 22:20:18    554s] 			checkbutton $pref_f.selectable_$i -anchor center -variable mgc_enc::vars(rve_${i}_selectable)
[05/05 22:20:18    554s] 			spinbox $pref_f.width_$i -state readonly -readonlybackground $bg -width 3 -from 1 -to 20 -increment 1 -bd 1 -textvariable mgc_enc::vars(rve_${i}_width)
[05/05 22:20:18    554s] 			grid $pref_f.label_$i $pref_f.color_$i $pref_f.pattern_$i $pref_f.selectable_$i $pref_f.width_$i -sticky nsew
[05/05 22:20:18    554s] 			set m [menu $pref_f.pattern_$i.menu]
[05/05 22:20:18    554s] 			foreach item $vars(rve_supported_patterns) {
[05/05 22:20:18    554s] 				$m add radiobutton -label $item -var mgc_enc::vars(rve_${i}_pattern) -value $item
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 			bind $c <Button-1> "mgc_enc::rve_choose_color $i" 
[05/05 22:20:18    554s] 			trace variable mgc_enc::vars(rve_${i}_color)   w "mgc_enc::rve_highlight_pattern_changed $i $c $pref_f.pattern_$i"
[05/05 22:20:18    554s] 			trace variable mgc_enc::vars(rve_${i}_pattern) w "mgc_enc::rve_highlight_pattern_changed $i $c $pref_f.pattern_$i"
[05/05 22:20:18    554s] 			trace variable mgc_enc::vars(rve_${i}_width)   w "mgc_enc::rve_highlight_pattern_changed $i $c $pref_f.pattern_$i"
[05/05 22:20:18    554s] 			set vars(rve_${i}_color) $vars(rve_${i}_color)
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		pack $pref_f -pady 1m -padx 2m -anchor s -fill x 
[05/05 22:20:18    554s] 		pack $options_f -pady 2m -expand yes -fill both -padx 2m -side top
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		frame $btns_f -relief raised -bd 1 
[05/05 22:20:18    554s] 		pack $btns_f -side bottom -fill x -anchor s
[05/05 22:20:18    554s] 		button $btns_f.save -width 7 -text "Save..." -command "mgc_enc::SaveRVELayerPreference $w"
[05/05 22:20:18    554s] 		button $btns_f.ok -width 7 -text "OK" -command "mgc_enc::SetupRVEOK $w"
[05/05 22:20:18    554s] 		button $btns_f.cancel -width 7 -text "Cancel" -command "mgc_enc::SetupRVECancel $w"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		pack $btns_f.save -expand 1 -padx 5m -pady 2m -side left
[05/05 22:20:18    554s] 		pack $btns_f.ok -expand 1 -padx 5m -pady 2m -side left
[05/05 22:20:18    554s] 		pack $btns_f.cancel -expand 1 -padx 5m -pady 2m -side left
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		focus $btns_f.ok
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		pack $w.top -side top -fill both -expand yes
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		#uiprocs_PositionWindow $w . "center"
[05/05 22:20:18    554s] 		mgc_enc::PositionWindowOnRight $w
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	for {set i 0} {$i<16} {incr i} {
[05/05 22:20:18    554s] 		if { ![catch {getLayerPreference rve_$i -color} color] } {
[05/05 22:20:18    554s] 			set vars(rve_${i}_color) $color
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		if { ![catch {getLayerPreference rve_$i -stipple} stipple] } {
[05/05 22:20:18    554s] 			set bOther 1
[05/05 22:20:18    554s] 			foreach item $vars(rve_supported_patterns) {
[05/05 22:20:18    554s] 				if { [string equal -nocase $item $stipple] || $stipple=="" } { 
[05/05 22:20:18    554s] 					set vars(rve_${i}_pattern) $item
[05/05 22:20:18    554s] 					set bOther 0
[05/05 22:20:18    554s] 					break
[05/05 22:20:18    554s] 				}
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 			if { $bOther } { set vars(rve_${i}_pattern) Other }
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		if { ![catch {getLayerPreference rve_$i -isSelectable} isSelectable] } {
[05/05 22:20:18    554s] 			if { [string is boolean -strict $isSelectable] } {
[05/05 22:20:18    554s] 				set vars(rve_${i}_selectable) $isSelectable
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		if { ![catch {getLayerPreference rve_$i -lineWidth} lineWidth] } {
[05/05 22:20:18    554s] 			if { [string is integer -strict $lineWidth] } {
[05/05 22:20:18    554s] 				set vars(rve_${i}_width) $lineWidth
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	wm transient $w .
[05/05 22:20:18    554s] 	wm deiconify $w
[05/05 22:20:18    554s] 	mgc_enc::WaitForUpdate
[05/05 22:20:18    554s] 	raise $w
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	# wait for return value to be set after grabbing focus
[05/05 22:20:18    554s] 	grab set $w
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	tkwait variable mgc_enc::vars(setupRVEStatus)
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	grab release $w   ;# Make sure we let go of grab
[05/05 22:20:18    554s] 	wm withdraw $w    ;# To allow reuse we just hide window
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return $mgc_enc::vars(setupRVEStatus)
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::setupSocket {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	append w .calibreSetupSocket
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set btns_f $w.top.btns
[05/05 22:20:18    554s] 	if {[winfo exists $w] == 0} {
[05/05 22:20:18    554s] 		toplevel $w
[05/05 22:20:18    554s] 		wm title $w "Calibre Setup Socket"
[05/05 22:20:18    554s] 		# Set the dialog up so that its width and height are resizable
[05/05 22:20:18    554s] 		wm resizable $w 1 1
[05/05 22:20:18    554s] 		wm withdraw $w
[05/05 22:20:18    554s] 		wm protocol $w WM_DELETE_WINDOW "mgc_enc::SetupSocketCancel $w"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		frame $w.top
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		bind $w <Escape> "mgc_enc::SetupSocketCancel $w"
[05/05 22:20:18    554s] 		bind $w <Return> "mgc_enc::SetupSocketOK $w"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		set options_f [frame $w.top.opts -relief groove -bd 2]
[05/05 22:20:18    554s] 		set socket_f [frame $options_f.socket_f]
[05/05 22:20:18    554s] 		set host_f   [frame $options_f.host_f]
[05/05 22:20:18    554s] 		pack [label $socket_f.label -pady 1 -text "Socket Number (-1 for auto):" -width 27 -anchor w] -side left
[05/05 22:20:18    554s] 		pack [entry $socket_f.entry -textvariable mgc_enc::vars(tmp_socket_number) -validate key -validatecommand "mgc_integer_only %P"] -side left -fill x -expand 1
[05/05 22:20:18    554s] 		pack [label $host_f.label -pady 1 -text "Host Name (empty for localhost):" -width 27 -anchor w] -side left
[05/05 22:20:18    554s] 		pack [entry $host_f.entry -textvariable mgc_enc::vars(tmp_socket_host) -validate key -validatecommand "mgc_no_white_spaces %P"] -side left -fill x -expand 1
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		pack $socket_f -pady 0.5m -padx 2m -anchor s -fill x 
[05/05 22:20:18    554s] 		pack $host_f   -pady 0.5m -padx 2m -anchor s -fill x 
[05/05 22:20:18    554s] 		pack $options_f -pady 2m -expand yes -fill both -padx 2m -side top
[05/05 22:20:18    554s]  
[05/05 22:20:18    554s] 		frame $btns_f -relief raised -bd 1 
[05/05 22:20:18    554s] 		pack $btns_f -side bottom -fill x -anchor s
[05/05 22:20:18    554s] 		button $btns_f.ok -width 7 -text "OK" -command "mgc_enc::SetupSocketOK $w"
[05/05 22:20:18    554s] 		button $btns_f.cancel -width 7 -text "Cancel" -command "mgc_enc::SetupSocketCancel $w"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		pack $btns_f.ok -expand 1 -padx 5m -pady 2m -side left
[05/05 22:20:18    554s] 		pack $btns_f.cancel -expand 1 -padx 5m -pady 2m -side left
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		focus $btns_f.ok
[05/05 22:20:18    554s] 		pack $w.top -side top -fill both -expand yes
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		#uiprocs_PositionWindow $w . "center"
[05/05 22:20:18    554s] 		mgc_enc::PositionWindowOnRight $w
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(tmp_socket_number) $vars(socket_number)
[05/05 22:20:18    554s] 	set vars(tmp_socket_host) $vars(socket_host)
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	wm transient $w .
[05/05 22:20:18    554s] 	wm deiconify $w
[05/05 22:20:18    554s] 	mgc_enc::WaitForUpdate
[05/05 22:20:18    554s] 	raise $w
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	# wait for return value to be set after grabbing focus
[05/05 22:20:18    554s] 	grab set $w
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	tkwait variable mgc_enc::vars(setupSocketStatus)
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	grab release $w   ;# Make sure we let go of grab
[05/05 22:20:18    554s] 	wm withdraw $w    ;# To allow reuse we just hide window
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return $mgc_enc::vars(setupSocketStatus)
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::clearHighlights {} {
[05/05 22:20:18    554s] 	mgc_rve_delete_markers "" 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::getVersion {} {
[05/05 22:20:18    554s] 	if { [info commands eval_legacy] == "eval_legacy" } {
[05/05 22:20:18    554s] 		set version [::get_db program_version]
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		set version [::getVersion] ;# 15.13-s048_1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return $version
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::versionIsPre9 {} {
[05/05 22:20:18    554s]     set version [getVersion]
[05/05 22:20:18    554s]     regsub {\..*$} $version {} majVersion
[05/05 22:20:18    554s]     if {[string match "0*" $majVersion]} {
[05/05 22:20:18    554s]         set majVersion [string range $majVersion 1 end]
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if {$majVersion < 9} {
[05/05 22:20:18    554s]         return 1
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     return 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::PositionWindowOnRight {w} {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     if {[mgc_enc::versionIsPre9]} {
[05/05 22:20:18    554s]         uiprocs_PositionWindow $w . "center"
[05/05 22:20:18    554s]     } else {
[05/05 22:20:18    554s] 	    global _ui_vars
[05/05 22:20:18    554s] 	    set geom [guiGet main -geometry]
[05/05 22:20:18    554s] 	    scan $geom "%dx%d+%d+%d" width height p_x p_y
[05/05 22:20:18    554s] 	    set x [expr $width+$p_x]
[05/05 22:20:18    554s] 	    set y $p_y
[05/05 22:20:18    554s] 	    wm withdraw $w
[05/05 22:20:18    554s] 	    mgc_enc::WaitForUpdate
[05/05 22:20:18    554s] 	    wm geometry $w +$x+$y
[05/05 22:20:18    554s] 	    if {$_ui_vars(IsPC)} {
[05/05 22:20:18    554s] 		    mgc_enc::WaitForUpdate      ;# required on pc to get positioning to occur
[05/05 22:20:18    554s] 	    }
[05/05 22:20:18    554s] 	    wm deiconify $w
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
