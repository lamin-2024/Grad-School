[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] ##################################################################################
[05/05 22:20:18    554s] #
[05/05 22:20:18    554s] # This file contains TCL code that opens a server socket and listens for
[05/05 22:20:18    554s] # Calibre-RVE commands on that socket.
[05/05 22:20:18    554s] # 
[05/05 22:20:18    554s] # This file should be sourced in the Encounter environment as follows:
[05/05 22:20:18    554s] #
[05/05 22:20:18    554s] # source encounter.tcl
[05/05 22:20:18    554s] #
[05/05 22:20:18    554s] ##################################################################################
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @package require Tcl 8.0
[05/05 22:20:18    554s] @package require Tk  8.0
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc cmn_source_widgets {} {
[05/05 22:20:18    554s] 	global _ui_vars _ui_fonts
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set geom [wm geom .]
[05/05 22:20:18    554s] 	set _ui_vars(MainGeometry) $geom
[05/05 22:20:18    554s] 	scan $geom "%dx%d+%d+%d" w h x y
[05/05 22:20:18    554s] 	set _ui_vars(wmframeW) [expr [winfo rootx .] - $x]
[05/05 22:20:18    554s] 	set _ui_vars(wmframeH) [expr [winfo rooty .] - $y]
[05/05 22:20:18    554s] 	
[05/05 22:20:18    554s] 	set _ui_fonts(Mono) -Adobe-Courier-Medium-R-Normal--*-150-*-*-*-*-*-*
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	global tcl_platform
[05/05 22:20:18    554s] 	if {$tcl_platform(platform) == "windows"} {
[05/05 22:20:18    554s] 		set _ui_vars(IsPC) 1
[05/05 22:20:18    554s] 		set _ui_vars(PathSeparator) ";"
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		set _ui_vars(IsPC) 0
[05/05 22:20:18    554s] 		set _ui_vars(PathSeparator) ":"
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @cmn_source_widgets
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @if {[info exists env(CALIBRE_HOME)] && ($env(CALIBRE_HOME) != "")} {
[05/05 22:20:18    554s]     set env(MGC_HOME) $env(CALIBRE_HOME)
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc uimessage_Note {pw msg} {
[05/05 22:20:18    554s] 	tk_messageBox -title Calibre -parent $pw -message $msg -type ok -icon info
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] @proc uimessage_Error {pw msg} {
[05/05 22:20:18    554s] 	tk_messageBox -title Calibre -parent $pw -message $msg -type ok -icon error
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc uimessage_YesNo {pw msg} {
[05/05 22:20:18    554s] 	tk_messageBox -title Calibre -parent $pw -message $msg -type yesno -icon question
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_integer_only {P} {
[05/05 22:20:18    554s] 	if { $P=="-" } {
[05/05 22:20:18    554s] 		return 1
[05/05 22:20:18    554s] 	} elseif { [regexp {[ \t\n]} $P] } {
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		return [string is integer $P]
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_no_white_spaces {P} {
[05/05 22:20:18    554s] 	if { [regexp {[ \t\n]} $P] } {
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		return 1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] ###############################################################################
[05/05 22:20:18    554s] # uiutils_MakeScrolledText --
[05/05 22:20:18    554s] #
[05/05 22:20:18    554s] # Provides an easy way of creating text widget with scrollbars
[05/05 22:20:18    554s] #
[05/05 22:20:18    554s] # Arguments:
[05/05 22:20:18    554s] #   <f>          = Frame that will contain everything(gets created below)
[05/05 22:20:18    554s] #   <scrollbars> = What type of scrollbars will be used:
[05/05 22:20:18    554s] #                    {vt, hz, both, none}
[05/05 22:20:18    554s] #   [args]       = The remaining args that get passed to text widget creation
[05/05 22:20:18    554s] #
[05/05 22:20:18    554s] # Returned Value:
[05/05 22:20:18    554s] #   Handle to internal text widget
[05/05 22:20:18    554s] #
[05/05 22:20:18    554s] @proc uiutils_MakeScrolledText {f scrollbars args} {
[05/05 22:20:18    554s] 	global _ui_vars
[05/05 22:20:18    554s]    
[05/05 22:20:18    554s] 	if ![winfo exists $f] {frame $f}
[05/05 22:20:18    554s] 	set main $f
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {$scrollbars == "both"} {
[05/05 22:20:18    554s] 		eval text $main.txt $args \
[05/05 22:20:18    554s] 			-yscroll {[list dynsbar2::scrollSet [list grid $main.vt -row 0 -column 1 -sticky ns]]} \
[05/05 22:20:18    554s] 			-xscroll {[list dynsbar2::scrollSet [list grid $main.hz -row 1 -column 0 -sticky we]]}
[05/05 22:20:18    554s] 		scrollbar $main.vt -orient verti -command "$main.txt yview"
[05/05 22:20:18    554s] 		scrollbar $main.hz -orient horiz -command "$main.txt xview"
[05/05 22:20:18    554s] 	} elseif {$scrollbars == "vt"} {
[05/05 22:20:18    554s] 		eval text $main.txt $args \
[05/05 22:20:18    554s] 			-yscroll {[list dynsbar2::scrollSet [list grid $main.vt -row 0 -column 1 -sticky ns]]}
[05/05 22:20:18    554s] 		scrollbar $main.vt -command "$main.txt yview"
[05/05 22:20:18    554s] 	} elseif {$scrollbars == "hz"} {
[05/05 22:20:18    554s] 		eval text $main.txt $args \
[05/05 22:20:18    554s] 			-xscroll {[list dynsbar2::scrollSet [list grid $main.hz -row 1 -column 0 -sticky we]]}
[05/05 22:20:18    554s] 		scrollbar $main.hz -orient horiz -command "$main.txt xview"
[05/05 22:20:18    554s] 	} elseif {$scrollbars == "none"} {
[05/05 22:20:18    554s] 		eval text $main.txt $args
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		return {}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s]    
[05/05 22:20:18    554s] 	grid $main.txt -row 0 -column 0 -sticky news
[05/05 22:20:18    554s] 	grid rowconfig $main 0 -weight 1
[05/05 22:20:18    554s] 	grid columnconfig $main 0 -weight 1
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return $main.txt
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] #################################################################
[05/05 22:20:18    554s] #
[05/05 22:20:18    554s] # uiprocs_PositionWindow -- Positions a window relative to the
[05/05 22:20:18    554s] #                     specified parent.
[05/05 22:20:18    554s] #
[05/05 22:20:18    554s] # Arguments:
[05/05 22:20:18    554s] #    <w>      = Window to be positioned
[05/05 22:20:18    554s] #    <parent> = Parent window it should be relative to
[05/05 22:20:18    554s] #    [mode]   = Defines relative position to parent
[05/05 22:20:18    554s] #    [showit] = Show window after setting geometry?
[05/05 22:20:18    554s] #
[05/05 22:20:18    554s] @proc uiprocs_PositionWindow {w parent {mode "center"} {showit {1}}} {
[05/05 22:20:18    554s]    global _ui_vars
[05/05 22:20:18    554s]    
[05/05 22:20:18    554s]    # First we will withdraw the window so user
[05/05 22:20:18    554s]    # doesn't see repaints caused by geometry change
[05/05 22:20:18    554s]    wm withdraw $w
[05/05 22:20:18    554s]    
[05/05 22:20:18    554s]    # Due to a problem in Tk4.x that exists on the PC, we must
[05/05 22:20:18    554s]    # force toplevel windows to be resizable for purposes of
[05/05 22:20:18    554s]    # letting Tk calculate geometry data. The effect of this
[05/05 22:20:18    554s]    # problem was that some dialogs would be sized incorrectly.
[05/05 22:20:18    554s]    set curr ""
[05/05 22:20:18    554s]    if {[winfo class $w] == "Toplevel"} {
[05/05 22:20:18    554s]       set curr [wm resizable $w] ;# save existing state
[05/05 22:20:18    554s]       wm resizable $w 1 1        ;# temporarily force resizable
[05/05 22:20:18    554s]    }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]    # It is critical that we "update" before
[05/05 22:20:18    554s]    # querying for geometry information
[05/05 22:20:18    554s]    update
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]    # Now it's safe to restore the resizable state of "w"
[05/05 22:20:18    554s]    if {$curr != ""} { eval wm resizable $w $curr }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]    # Get screen info
[05/05 22:20:18    554s]    set edge_right [winfo screenwidth .]
[05/05 22:20:18    554s]    set edge_bottom [winfo screenheight .]
[05/05 22:20:18    554s]    
[05/05 22:20:18    554s]    # Get parent info.  We first check if it's a toplevel
[05/05 22:20:18    554s]    # window by seeing if we can get wm geometry info.  We
[05/05 22:20:18    554s]    # really only want the x/y values from the "wm geometry"
[05/05 22:20:18    554s]    # call since they take into account the window's frame.
[05/05 22:20:18    554s]    if {[catch {wm geometry $parent} geom] != 0} {
[05/05 22:20:18    554s]       # If it's not a toplevel window then get the
[05/05 22:20:18    554s]       # "root-relative" x/y values
[05/05 22:20:18    554s]       set p_x      [winfo rootx $parent]
[05/05 22:20:18    554s]       set p_y      [winfo rooty $parent]
[05/05 22:20:18    554s]    } else {
[05/05 22:20:18    554s]       scan $geom "%dx%d+%d+%d" width height p_x p_y
[05/05 22:20:18    554s]    }
[05/05 22:20:18    554s]    set p_width  [winfo width $parent]
[05/05 22:20:18    554s]    set p_height [winfo height $parent]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]    # Get info for target window(if curr size info
[05/05 22:20:18    554s]    # is not yet known then we have to use "requested" info)
[05/05 22:20:18    554s]    set w_width  [winfo width $w]
[05/05 22:20:18    554s]    set w_height [winfo height $w]
[05/05 22:20:18    554s]    if {$w_width == 1} {
[05/05 22:20:18    554s]       set w_width  [winfo reqwidth $w]
[05/05 22:20:18    554s]       set w_height [winfo reqheight $w]
[05/05 22:20:18    554s]    }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]    set x {}
[05/05 22:20:18    554s]    set y {}
[05/05 22:20:18    554s]    switch $mode {
[05/05 22:20:18    554s]       "center" {
[05/05 22:20:18    554s]          set x [expr {$p_x + ($p_width/2) - ($w_width/2)}]
[05/05 22:20:18    554s]          set y [expr {$p_y + ($p_height/2) - ($w_height/2)}]
[05/05 22:20:18    554s]          # Adjust so window doesn't go off the screen
[05/05 22:20:18    554s]          if {$x < 0} { set x 0 } \
[05/05 22:20:18    554s]          elseif {[expr {$x + $w_width + (2* $_ui_vars(wmframeW))}] > $edge_right} {
[05/05 22:20:18    554s]             set x [expr {$x - ($x + $w_width + (2* $_ui_vars(wmframeW)) - $edge_right)}]
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]          if {$y < 0} { set y 0 }
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s]       "bottom" {
[05/05 22:20:18    554s]          set x $p_x
[05/05 22:20:18    554s]          set y [expr {$p_y + $p_height}]
[05/05 22:20:18    554s]          # Adjust so window doesn't go off the screen
[05/05 22:20:18    554s]          if {$x < 0} {set x 0} \
[05/05 22:20:18    554s]          elseif {[expr {$x + $w_width + (2* $_ui_vars(wmframeW))}] > $edge_right} {
[05/05 22:20:18    554s]             set x [expr {$x - ($x + $w_width + (2* $_ui_vars(wmframeW)) - $edge_right)}]
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]          if {$y < 0} { set y 0 } \
[05/05 22:20:18    554s]          elseif {[expr {$y + $w_height}] > $edge_bottom} {
[05/05 22:20:18    554s]             incr y [expr {$edge_bottom - ($y + $w_height)}]
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]          # Check if we need to account for window manager decoration frame width
[05/05 22:20:18    554s]          if {($parent == ".") || \
[05/05 22:20:18    554s]              [regexp {Toplevel|FileViewer|ReportViewer} [winfo class $parent]]} {
[05/05 22:20:18    554s]             set y [expr {$y + $_ui_vars(wmframeH) + 5}] 
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s]       "screencenter" {
[05/05 22:20:18    554s]          set x [expr {($edge_right/2) - ($w_width/2)}]
[05/05 22:20:18    554s]          set y [expr {($edge_bottom/2) - ($w_height/2)}]
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s]       "right" -
[05/05 22:20:18    554s]       "righttop" -
[05/05 22:20:18    554s]       "rightmiddle" -
[05/05 22:20:18    554s]       "rightbottom" {
[05/05 22:20:18    554s]          set x [expr {$p_x + $p_width}]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]          # Check if we need to account for window manager decoration frame width
[05/05 22:20:18    554s]          if {($parent == ".") || \
[05/05 22:20:18    554s]              [regexp {Toplevel|FileViewer|ReportViewer} [winfo class $parent]]} {
[05/05 22:20:18    554s]             set x [expr {$x + (2* $_ui_vars(wmframeW)) + 2}]
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]          if {[expr {$x + $w_width}] > $edge_right} {
[05/05 22:20:18    554s]             # Adjust so window doesn't go off the screen
[05/05 22:20:18    554s]             set x [expr {$x - ($x + $w_width - $edge_right)}]
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]          if {($mode == "right") || ($mode == "righttop")} {
[05/05 22:20:18    554s]             set y [expr {$p_y}]
[05/05 22:20:18    554s]          } elseif {$mode == "rightmiddle"} {
[05/05 22:20:18    554s]             set y [expr {$p_y + ($p_height/2) - ($w_height/2)}]
[05/05 22:20:18    554s]          } elseif {$mode == "rightbottom"} {
[05/05 22:20:18    554s]             set y [expr {$p_y + $p_height - $w_height}]
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s]       "left" {
[05/05 22:20:18    554s]          set x [expr {$p_x - $w_width}]
[05/05 22:20:18    554s]          set y $p_y
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]          # Check if we need to account for window manager decoration frame width
[05/05 22:20:18    554s]          if {($parent == ".") || \
[05/05 22:20:18    554s]              [regexp {Toplevel|FileViewer|ReportViewer} [winfo class $parent]]} {
[05/05 22:20:18    554s]             set x [expr {$x - (2* $_ui_vars(wmframeW)) - 2}]
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]          # Adjust so window doesn't go off the screen
[05/05 22:20:18    554s]          if {$x < 0} { set x 0 }
[05/05 22:20:18    554s]          if {$y < 0} { set y 0 } \
[05/05 22:20:18    554s]          elseif {[expr {$y + $w_height}] > $edge_bottom} {
[05/05 22:20:18    554s]             incr y [expr {$edge_bottom - ($y + $w_height)}]
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s]       "straddleright" -
[05/05 22:20:18    554s]       "straddlerightbottom" {
[05/05 22:20:18    554s]          set x [expr {$p_x + $p_width - ($w_width / 2)}]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]          # Check if we need to account for window manager decoration frame width
[05/05 22:20:18    554s]          if {($parent == ".") || \
[05/05 22:20:18    554s]              [regexp {Toplevel|FileViewer|ReportViewer} [winfo class $parent]]} {
[05/05 22:20:18    554s]             set x [expr {$x + $_ui_vars(wmframeW) + 1}]
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]          if {[expr {$x + $w_width}] > $edge_right} {
[05/05 22:20:18    554s]             # Adjust so window doesn't go off the screen
[05/05 22:20:18    554s]             set x [expr {$x - ($x + $w_width - $edge_right)}]
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]          if {$mode == "straddleright"} {
[05/05 22:20:18    554s]             set y [expr {$p_y + ($p_height/2) - ($w_height/2)}]
[05/05 22:20:18    554s]          } else {
[05/05 22:20:18    554s]             set y [expr {$p_y + $p_height - ($w_height/2)}]
[05/05 22:20:18    554s]             
[05/05 22:20:18    554s]             # Adjust so window doesn't go off the screen
[05/05 22:20:18    554s]             if {[expr {$y + $w_height}] > $edge_bottom} {
[05/05 22:20:18    554s]                incr y [expr {$edge_bottom - ($y + $w_height)}]
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]          # Check if we need to account for window manager decoration frame width
[05/05 22:20:18    554s]          if {($parent == ".") || \
[05/05 22:20:18    554s]              [regexp {Toplevel|FileViewer|ReportViewer} [winfo class $parent]]} {
[05/05 22:20:18    554s]             set y [expr {$y - $_ui_vars(wmframeH) - 2}]
[05/05 22:20:18    554s]          }
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s]    }
[05/05 22:20:18    554s]    
[05/05 22:20:18    554s]    wm geometry $w +$x+$y
[05/05 22:20:18    554s]    if {$_ui_vars(IsPC)} {
[05/05 22:20:18    554s]       update idletasks     ;# required on pc to get positioning to occur
[05/05 22:20:18    554s]    }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]    # Now we can show the window(if requested)
[05/05 22:20:18    554s]    if {$showit == 1} {
[05/05 22:20:18    554s]       wm deiconify $w
[05/05 22:20:18    554s]       #raise $w
[05/05 22:20:18    554s]    }
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] # Dynamic scrolling, take two . . . 
[05/05 22:20:18    554s] @namespace eval dynsbar2 {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	namespace export scrollSet hierScrollSet
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	proc scrollSet {pcmd first last} {
[05/05 22:20:18    554s] 		ScrollSet $pcmd $first $last
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	# hier adheres to old scrolling set subcommand format
[05/05 22:20:18    554s] 	proc hierScrollSet {pcmd tU wU fU lU} {
[05/05 22:20:18    554s] 		incr tU -1 ; # Bug in hw_hier.c? Gives us one more than the number of rows.
[05/05 22:20:18    554s] 		if {$tU==0} {
[05/05 22:20:18    554s] 			set first 0.0
[05/05 22:20:18    554s] 			set last 1.0
[05/05 22:20:18    554s] 		} else {
[05/05 22:20:18    554s] 			set first [expr {double($fU) / $tU}]
[05/05 22:20:18    554s] 			set last  [expr {double($lU) / $tU}]
[05/05 22:20:18    554s] 			if {$first<0.0} {set first 0.0}
[05/05 22:20:18    554s] 			if {$last>1.0} {set last 1.0}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		ScrollSet $pcmd $first $last
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	proc ScrollSet {pcmd first last} {
[05/05 22:20:18    554s] 		set sbar [lindex $pcmd 1]
[05/05 22:20:18    554s] 		$sbar set $first $last
[05/05 22:20:18    554s] 		if {($first!=$last) && (($first>0) || (($last>0) && ($last<1)))} {
[05/05 22:20:18    554s] 			eval $pcmd
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @namespace eval mgc_enc {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	variable cmap
[05/05 22:20:18    554s]     variable hlTextObjs
[05/05 22:20:18    554s]     variable hlEdgeObjs
[05/05 22:20:18    554s]     variable hlPolyObjs
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	global env
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(ENV_VARNAME) "MGC_CALIBRE_LAYOUT_SERVER"
[05/05 22:20:18    554s] 	set env(MGC_CALIBRE_LAYOUT_SERVER_NAME) "Cadence:Encounter"
[05/05 22:20:18    554s] 	set env(MGC_CGI_MONITOR_STDIN) 1
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     # Turn on support for shorthand text highlight command
[05/05 22:20:18    554s]     set env(MGC_RVE_HILIGHT_SHORT_TEXT_CMDS) 1
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(DEFAULT_PORT) 9189
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(RFILE_BUSY) 0
[05/05 22:20:18    554s] 	set vars(hl_objects) {}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(hl_layer) "rve_0"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(hl_layer_basen) rve
[05/05 22:20:18    554s] 	set vars(hl_layer_index) 0
[05/05 22:20:18    554s] 	set vars(max_hl_layer) 0
[05/05 22:20:18    554s] 	set vars(got_show_layers) 0
[05/05 22:20:18    554s] 	set vars(show_layers_lsw_is_current) 0
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(server_sid) ""
[05/05 22:20:18    554s] 	set vars(last_client_sid) ""
[05/05 22:20:18    554s] 	set vars(client_sockets)    {}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(SRANGE_START) 5000
[05/05 22:20:18    554s] 	set vars(SRANGE_END)   9999
[05/05 22:20:18    554s] 	set vars(socket_number) -1
[05/05 22:20:18    554s] 	set vars(socket_host)   ""
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set vars(runcode_version) 4.4
[05/05 22:20:18    554s]     set vars(protocol_version) 4.6
[05/05 22:20:18    554s]     set vars(optionalCommands) [list    \
[05/05 22:20:18    554s]         "mgc_rve_get_poly"              \
[05/05 22:20:18    554s]     ]
[05/05 22:20:18    554s]     set vars(CI_trigger_keys) [list]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     variable userCmds
[05/05 22:20:18    554s]     array set userCmds {}
[05/05 22:20:18    554s]     set vars(userCmdIdx) 0
[05/05 22:20:18    554s]     set vars(menuCmds) [list]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     array set hlTextObjs {}
[05/05 22:20:18    554s]     array set hlEdgeObjs {}
[05/05 22:20:18    554s]     array set hlPolyObjs {}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	# Name Other is intended for -stippleData option in setLayerPreference, we don't support it here since it don't have stipple name 
[05/05 22:20:18    554s] 	set vars(rve_supported_patterns) [list None Solid Horizontal Vertical Grid Slash Backslash Cross Brick Other]
[05/05 22:20:18    554s] 	set vars(OptionsFile) ".rveencdb"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	foreach type {"GDS" "Verilog" "DEF"} {
[05/05 22:20:18    554s] 		if {![info exists vars(exportOptions$type)]} {
[05/05 22:20:18    554s] 			set vars(exportOptions$type) ""
[05/05 22:20:18    554s]             if {$type eq "Verilog"} {
[05/05 22:20:18    554s]                 if {[info exists env(MGC_CALIBRE_VERILOG_EXPORT_PARAM_FILE)]} {
[05/05 22:20:18    554s]                     set vlog_cnfig_file $env(MGC_CALIBRE_VERILOG_EXPORT_PARAM_FILE)
[05/05 22:20:18    554s]                     if {[file exists $vlog_cnfig_file]} {
[05/05 22:20:18    554s]                         if {![catch {set rf [open $vlog_cnfig_file r]}]} {
[05/05 22:20:18    554s]                             set vars(exportOptionsVerilog) [read $rf]
[05/05 22:20:18    554s]                             close $rf
[05/05 22:20:18    554s]                         } else {
[05/05 22:20:18    554s]                             puts "Can't open MGC_CALIBRE_VERILOG_EXPORT_PARAM_FILE \"$vlog_cnfig_file\" for reading"
[05/05 22:20:18    554s]                         }
[05/05 22:20:18    554s]                     } else {
[05/05 22:20:18    554s]                         puts "Can't find MGC_CALIBRE_VERILOG_EXPORT_PARAM_FILE \"$vlog_cnfig_file\""
[05/05 22:20:18    554s]                     }
[05/05 22:20:18    554s]                 }
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		if {![info exists vars(showDlgRunTime$type)]} {
[05/05 22:20:18    554s] 			set vars(showDlgRunTime$type) 0
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::initRveHighlightPatterns {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	for {set i 0} {$i<16} {incr i} {
[05/05 22:20:18    554s] 		set vars(rve_${i}_color)    red
[05/05 22:20:18    554s] 		set vars(rve_${i}_pattern) None
[05/05 22:20:18    554s] 		set vars(rve_${i}_selectable) 1
[05/05 22:20:18    554s] 		set vars(rve_${i}_width)      1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if { [lsearch [package names] BLT]<0 } {
[05/05 22:20:18    554s] 		return 1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	# 16X16 named bitmap patterns supported in Encounter
[05/05 22:20:18    554s] 	blt::bitmap define ::mgc_enc::Pattern_None {
[05/05 22:20:18    554s] 		#define none16x16_width 16
[05/05 22:20:18    554s] 		#define none16x16_height 16
[05/05 22:20:18    554s] 		static unsigned char none16x16_bits[] = {
[05/05 22:20:18    554s] 			0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
[05/05 22:20:18    554s] 			0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
[05/05 22:20:18    554s] 			0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	blt::bitmap define ::mgc_enc::Pattern_Solid {
