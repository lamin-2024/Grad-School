[05/05 22:20:18    554s] @proc calibre_autofix {args} {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     # Check if design is loaded
[05/05 22:20:18    554s]     if {[dbgTopCell]==0} {
[05/05 22:20:18    554s]         error "No design loaded!"
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if {[string compare $args ""]} {
[05/05 22:20:18    554s]         # If setup file is provided from icc_shell
[05/05 22:20:18    554s]         set setup_file $args
[05/05 22:20:18    554s]     } else {
[05/05 22:20:18    554s]         # If setup file is not provided open Select Setup File form
[05/05 22:20:18    554s]         set types {
[05/05 22:20:18    554s]             {"Tcl Files"     {.tcl} }
[05/05 22:20:18    554s]             {"All files"     *      }
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         set setup_file [tk_getOpenFile -title "Select Setup File" -filetypes $types -parent .]
[05/05 22:20:18    554s]         # Selecting file is canceled
[05/05 22:20:18    554s]         if {![string compare $setup_file ""]} {
[05/05 22:20:18    554s]             return
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set fid [open "| $::env(MGC_HOME)/bin/calibre -autofix $setup_file"]
[05/05 22:20:18    554s]     while {[gets $fid line]  >= 0} {
[05/05 22:20:18    554s]         puts $line
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if {[catch {close $fid} msg] != 0} {
[05/05 22:20:18    554s]         if {[string match "*WARNING*" $msg]} {
[05/05 22:20:18    554s]             puts $msg
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             error $msg
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         global errorCode
[05/05 22:20:18    554s]         if {"CHILDSTATUS" == [lindex $errorCode 0]} {
[05/05 22:20:18    554s]             set exit_status [lindex $errorCode 2]
[05/05 22:20:18    554s]             puts "exit status is $exit_status"
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set fid [open $setup_file r]
[05/05 22:20:18    554s]     while {[gets $fid value]  >= 0} {
[05/05 22:20:18    554s]         if [string match "*set_output_dir*" $value] {
[05/05 22:20:18    554s]             set words [regexp -all -inline {\S+} $value]
[05/05 22:20:18    554s]             set first [lindex $words 0]
[05/05 22:20:18    554s]             if {![string match "#*" $first]} {
[05/05 22:20:18    554s]                 set dir [lindex $words 1]
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]         } elseif [string match "*set_output_def_file*" $value] {
[05/05 22:20:18    554s]             set words [regexp -all -inline {\S+} $value]
[05/05 22:20:18    554s]             set first [lindex $words 0]
[05/05 22:20:18    554s]             if {![string match "#*" $first]} {
[05/05 22:20:18    554s]                 set def [lindex $words 1]
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]         } elseif [string match "*set_output_eco_file*" $value] {
[05/05 22:20:18    554s]             set words [regexp -all -inline {\S+} $value]
[05/05 22:20:18    554s]             set first [lindex $words 0]
[05/05 22:20:18    554s]             if {![string match "#*" $first]} {
[05/05 22:20:18    554s]                 set eco [lindex $words 1]
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]         } 
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if {![info exists dir]} {
[05/05 22:20:18    554s]         # set_output_dir command is not in the setup file or commented
[05/05 22:20:18    554s]         set dir Autofix
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if {![info exists def]} {
[05/05 22:20:18    554s]         # set_output_def_file command is not in the setup file or commented
[05/05 22:20:18    554s]         set def calibre_autofix.def
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if {[info exists eco] && $eco eq "edi"} {
[05/05 22:20:18    554s]         source $dir/calibre_autofix.tcl
[05/05 22:20:18    554s]     } else {
[05/05 22:20:18    554s]         defIn -specialnets -nets $dir/$def
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc useECOFile {$dir} {
[05/05 22:20:18    554s]     set rVal 0
[05/05 22:20:18    554s]     if {[file readable $dir/calibre_autofix.tcl]} {
[05/05 22:20:18    554s]         set rVal 1
[05/05 22:20:18    554s]     } 
[05/05 22:20:18    554s]     return $rVal
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] ### End verbose source output for '/proj/cad/mentor_2021/aoi_cal_2021.1_33.19/shared/pkgs/icv/tools/queryenc/edi_autofix_cmd.tcl'.
