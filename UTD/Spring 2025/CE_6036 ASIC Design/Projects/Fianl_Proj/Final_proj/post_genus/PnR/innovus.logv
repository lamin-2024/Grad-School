[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_layer {args} {}
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_instance {args} {}
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_device {args} {}
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_port {args} {}
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_pin {args} {}
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_property {args} {}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CheckName {name} {
[05/05 22:20:18    554s] 	set end [string length $name]
[05/05 22:20:18    554s] 	incr end -1
[05/05 22:20:18    554s] 	if {([string index $name 0]!="\"") || ([string index $name $end]!="\"")} {
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CheckInteger {num} {
[05/05 22:20:18    554s] 	# No string is functions in Tcl 8.0
[05/05 22:20:18    554s] 	#if {![string is integer -strict $num]} {
[05/05 22:20:18    554s] 	#	return 0
[05/05 22:20:18    554s] 	#}
[05/05 22:20:18    554s] 	if {[scan $num "%d" inum]!=1} {
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CheckNumber {num} {
[05/05 22:20:18    554s] 	#   No string is functions in Tcl 8.0
[05/05 22:20:18    554s] 	#if {![string is double -strict $num]} {
[05/05 22:20:18    554s] 	#	return 0
[05/05 22:20:18    554s] 	#}
[05/05 22:20:18    554s] 	if {[scan $num "%g" dnum]!=1} {
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] ################################################################################
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::ProcessRveFile {f} {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set linecount 0
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	while {[gets $f rline]!=-1} {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		incr linecount
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		set line [split $rline]
[05/05 22:20:18    554s] 		set cmd  [lindex $line 0]
[05/05 22:20:18    554s] 		set args [lrange $line 1 end]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		switch -- $cmd {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 			"mp" -
[05/05 22:20:18    554s] 			"me" -
[05/05 22:20:18    554s] 			"ml" - 
[05/05 22:20:18    554s] 			"mr" -
[05/05 22:20:18    554s] 			"mpc" -
[05/05 22:20:18    554s] 			"mec" -
[05/05 22:20:18    554s] 			"mgc_rve_zoom" -
[05/05 22:20:18    554s] 			"mgc_rve_poly" -
[05/05 22:20:18    554s] 			"mgc_rve_poly_clear" -
[05/05 22:20:18    554s] 			"mgc_rve_edge" -
[05/05 22:20:18    554s] 			"mgc_rve_edge_clear" -
[05/05 22:20:18    554s] 			"mgc_rve_line" -
[05/05 22:20:18    554s] 			"mgc_rve_rect" {
[05/05 22:20:18    554s] 				set ret [eval $cmd $args]
[05/05 22:20:18    554s] 				if { $ret==0 || $ret=="" } {return $linecount}
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 			"mgc_rve_context" {
[05/05 22:20:18    554s] 				if {[llength $args]!=2} {return $linecount}
[05/05 22:20:18    554s] 				set cell [lindex $args 0]
[05/05 22:20:18    554s] 				set precision [lindex $args 1]
[05/05 22:20:18    554s] 				if {![CheckInteger $precision]} {return $linecount}
[05/05 22:20:18    554s] 				if {![CheckName $cell]} {
[05/05 22:20:18    554s] 					return $linecount
[05/05 22:20:18    554s] 				}
[05/05 22:20:18    554s] 				if {![$cmd $cell $precision]} {return $linecount}
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 			"mgc_rve_delete_markers" {
[05/05 22:20:18    554s] 				if {[llength $args]!=0} {return $linecount}
[05/05 22:20:18    554s] 				if {![$cmd]} {return $linecount}
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 			"mgc_rve_text" -
[05/05 22:20:18    554s] 			"mgc_rve_text_clear" -
[05/05 22:20:18    554s] 			"mt" -
[05/05 22:20:18    554s] 			"mtc" {
[05/05 22:20:18    554s] 				if {[llength $args]!=4} {return $linecount}
[05/05 22:20:18    554s] 				foreach a [lrange $args 1 end] {
[05/05 22:20:18    554s] 					if {![CheckNumber $a]} {
[05/05 22:20:18    554s] 						return $linecount
[05/05 22:20:18    554s] 					}
[05/05 22:20:18    554s] 				}
[05/05 22:20:18    554s] 				set ret [eval $cmd $args] 
[05/05 22:20:18    554s] 				if { $ret==0 || $ret=="" } {return $linecount}
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 			"" -
[05/05 22:20:18    554s] 			"mgc_rve_layer" -
[05/05 22:20:18    554s] 			"mgc_rve_instance" -
[05/05 22:20:18    554s] 			"mgc_rve_device" -
[05/05 22:20:18    554s] 			"mgc_rve_port" -
[05/05 22:20:18    554s] 			"mgc_rve_pin" -
[05/05 22:20:18    554s] 			"mgc_rve_property" {
[05/05 22:20:18    554s] 				# skip these lines
[05/05 22:20:18    554s] 				continue
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 			"mgc_rve_show_layers" {
[05/05 22:20:18    554s] 				if {![eval $cmd $args]} {return $linecount}
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 			default {
[05/05 22:20:18    554s] 				return $linecount
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mp {args} {return [eval mgc_rve_poly $args]}
[05/05 22:20:18    554s] @proc mgc_enc::mpc {args} {return [eval mgc_rve_poly_clear $args]}
[05/05 22:20:18    554s] @proc mgc_enc::mr {args} {return [eval mgc_rve_rect $args]}
[05/05 22:20:18    554s] @proc mgc_enc::me {args} {return [eval mgc_rve_edge $args]}
[05/05 22:20:18    554s] @proc mgc_enc::mec {args} {return [eval mgc_rve_edge_clear $args]}
[05/05 22:20:18    554s] @proc mgc_enc::ml {args} {return [eval mgc_rve_line $args]}
[05/05 22:20:18    554s] @proc mgc_enc::mt {args} {return [eval mgc_rve_text $args]}
[05/05 22:20:18    554s] @proc mgc_enc::mtc {args} {return [eval mgc_rve_text_clear $args]}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_rect {args} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	variable hlPolyObjs
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {[llength $args]<4} {return 0}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set llx [lindex $args 0]
[05/05 22:20:18    554s] 	set lly [lindex $args 1]
[05/05 22:20:18    554s] 	set urx [lindex $args 2]
[05/05 22:20:18    554s] 	set ury [lindex $args 3]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set oid [createGuiRect $vars(hl_layer) $llx $lly $urx $ury]
[05/05 22:20:18    554s] 	lappend hlPolyObjs($llx,$lly) $oid
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return [list $oid]
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] # We must accommodate trailing property name/val pairs; ignore them 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_poly {args} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	variable hlPolyObjs
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vcount [lindex $args 0]
[05/05 22:20:18    554s] 	set coords [lrange $args 1 end]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set coords_len [expr {($vcount*2)}]
[05/05 22:20:18    554s] 	if {[llength $coords] < $coords_len} {
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {$vcount==4} {
[05/05 22:20:18    554s] 		# decide if this is a rectangle
[05/05 22:20:18    554s] 		set llx [lindex $coords 0]
[05/05 22:20:18    554s] 		set lly [lindex $coords 1]
[05/05 22:20:18    554s] 		set p2x [lindex $coords 2]
[05/05 22:20:18    554s] 		set p2y [lindex $coords 3]
[05/05 22:20:18    554s] 		set urx [lindex $coords 4]
[05/05 22:20:18    554s] 		set ury [lindex $coords 5]
[05/05 22:20:18    554s] 		set p4x [lindex $coords 6]
[05/05 22:20:18    554s] 		set p4y [lindex $coords 7]
[05/05 22:20:18    554s] 		if {($lly==$p2y) && ($llx==$p4x) && ($urx==$p2x) && ($ury==$p4y)} {
[05/05 22:20:18    554s] 			set oid [createGuiRect $vars(hl_layer) $llx $lly $urx $ury]
[05/05 22:20:18    554s] 			lappend hlPolyObjs($llx,$lly) $oid
[05/05 22:20:18    554s] 			return [list $oid]
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set fx [lindex $coords 0] ; set fy [lindex $coords 1]
[05/05 22:20:18    554s] 	set x1 $fx ; set y1 $fy
[05/05 22:20:18    554s] 	incr coords_len -1
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set lOids []
[05/05 22:20:18    554s] 	foreach {x2 y2} [lrange $coords 2 $coords_len] {
[05/05 22:20:18    554s] 		set oid [createGuiLine $vars(hl_layer) $x1 $y1 $x2 $y2]
[05/05 22:20:18    554s] 		lappend hlPolyObjs($fx,$fy) $oid
[05/05 22:20:18    554s] 		lappend lOids $oid
[05/05 22:20:18    554s] 		set x1 $x2 ; set y1 $y2
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	set oid [createGuiLine $vars(hl_layer) $x2 $y2 $fx $fy]
[05/05 22:20:18    554s] 	lappend hlPolyObjs($fx,$fy) $oid
[05/05 22:20:18    554s] 	lappend lOids $oid
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return $lOids
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] # We must accommodate trailing property name/val pairs; ignore them 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_edge {args} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	variable hlEdgeObjs
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set ecount [lindex $args 0]
[05/05 22:20:18    554s] 	set coords [lrange $args 1 end]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set coords_len [expr {($ecount*4)}]
[05/05 22:20:18    554s] 	if {[llength $coords] < $coords_len} {
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set lOids []
[05/05 22:20:18    554s] 	incr coords_len -1
[05/05 22:20:18    554s] 	set x0 [lindex $coords 0]
[05/05 22:20:18    554s] 	set y0 [lindex $coords 1]
[05/05 22:20:18    554s] 	for {set i 0} {$i < $ecount} {incr i} {
[05/05 22:20:18    554s] 		set vindex [expr {$i*4}]
[05/05 22:20:18    554s] 		set x1 [lindex $coords $vindex] ; incr vindex
[05/05 22:20:18    554s] 		set y1 [lindex $coords $vindex] ; incr vindex
[05/05 22:20:18    554s] 		set x2 [lindex $coords $vindex] ; incr vindex
[05/05 22:20:18    554s] 		set y2 [lindex $coords $vindex]
[05/05 22:20:18    554s] 		set oid [createGuiLine $vars(hl_layer) $x1 $y1 $x2 $y2]
[05/05 22:20:18    554s] 		lappend hlEdgeObjs($x0,$y0) $oid
[05/05 22:20:18    554s] 		lappend lOids $oid
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return $lOids
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_line {args} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	set vcount [lindex $args 0]
[05/05 22:20:18    554s] 	set coords [lrange $args 1 end]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {[llength $coords]!=[expr {$vcount*2}]} {return 0}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set lOids []
[05/05 22:20:18    554s] 	set x1 [lindex $coords 0] ; set y1 [lindex $coords 1]
[05/05 22:20:18    554s] 	foreach {x2 y2} [lrange $coords 2 end] {
[05/05 22:20:18    554s] 		set oid [createGuiLine $vars(hl_layer) $x1 $y1 $x2 $y2]
[05/05 22:20:18    554s] 		lappend lOids $oid
[05/05 22:20:18    554s] 		set x1 $x2 ; set y1 $y2
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return $lOids
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_text_clear {name x y size} {
[05/05 22:20:18    554s]     variable hlTextObjs 
[05/05 22:20:18    554s]     if {[info exists hlTextObjs($x,$y)]} {
[05/05 22:20:18    554s]         foreach obj $hlTextObjs($x,$y) {
[05/05 22:20:18    554s]             catch {deleteGuiObj $obj}
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         unset hlTextObjs($x,$y)
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_edge_clear {num_edges args} {
[05/05 22:20:18    554s]     variable hlEdgeObjs 
[05/05 22:20:18    554s]     foreach {x y} $args {break}
[05/05 22:20:18    554s]     if {[info exists hlEdgeObjs($x,$y)]} {
[05/05 22:20:18    554s]         foreach obj $hlEdgeObjs($x,$y) {
[05/05 22:20:18    554s]             catch {deleteGuiObj $obj}
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         unset hlEdgeObjs($x,$y)
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_poly_clear {num_pts args} {
[05/05 22:20:18    554s]     variable hlPolyObjs 
[05/05 22:20:18    554s]     foreach {x y} $args {break}
[05/05 22:20:18    554s]     if {[info exists hlPolyObjs($x,$y)]} {
[05/05 22:20:18    554s]         foreach obj $hlPolyObjs($x,$y) {
[05/05 22:20:18    554s]             catch {deleteGuiObj $obj}
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         unset hlPolyObjs($x,$y)
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_text {args} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	variable hlTextObjs
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {[llength $args]!=4} {return 0}
[05/05 22:20:18    554s] 	set tstr [string trim [lindex $args 0] "\""]
[05/05 22:20:18    554s] 	set x [lindex $args 1]
[05/05 22:20:18    554s] 	set y [lindex $args 2]
[05/05 22:20:18    554s] 	set tsize [lindex $args 3]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set oid [createGuiText $vars(hl_layer) "$tstr" $x $y $tsize]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	lappend hlTextObjs($x,$y) $oid
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return [list $oid]
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_start_results_set {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	set vars(got_show_layers) 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_end_results_set {} {
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_get_all_metal_layers {} {
[05/05 22:20:18    554s] 	set metalLayers [getAllLayers metal]
[05/05 22:20:18    554s] 	# DR1280698: RTD with "Visible layer only checks" recipe ...
[05/05 22:20:18    554s] 	# add allM0 - allM# and allM1Cont - allM#Cont support
[05/05 22:20:18    554s] 	set i 0
[05/05 22:20:18    554s] 	while { [catch {set layer [getLayerByName M$i]}]==0 && $layer } {
[05/05 22:20:18    554s] 		# lappend lValidMetalLayers M${i}
[05/05 22:20:18    554s] 		lappend metalLayers "allM${i}"
[05/05 22:20:18    554s] 		lappend metalLayers "allM[expr $i+1]Cont"
[05/05 22:20:18    554s] 		incr i
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return $metalLayers
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_show_layers {args} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set metalLayers [mgc_rve_get_all_metal_layers]
[05/05 22:20:18    554s] 	foreach layer $metalLayers {
[05/05 22:20:18    554s] 		foreach spec $args {
[05/05 22:20:18    554s] 			# get the layer name, skip layer purpose
[05/05 22:20:18    554s] 			set spec [lindex [split $spec ":"] 0]
[05/05 22:20:18    554s] 			set layerMatched [string match "$spec" $layer]
[05/05 22:20:18    554s] 			# DR 1393161 CTO layer visibility not being applied when using Innovus 19.11 or CUI mode in 18.10 or 19.11
[05/05 22:20:18    554s] 			# In Innovus 19.10/19.11 CUI/Legacy mode, M0/M1/.. is replaced with M0Wire/M1Wire/...
[05/05 22:20:18    554s] 			if { !$layerMatched && [regexp {(M[0-9]+)Wire} $layer ignore wireLayer] } {
[05/05 22:20:18    554s] 				# 'wireLayer' variable is the layer name like M1 _without_ 'Wire' suffix
[05/05 22:20:18    554s] 				# Innovus 19.11: getLayerPreference M8 -isVisible  => **ERROR: (IMPSYC-1885): Layer 'M8' does not exist.
[05/05 22:20:18    554s] 				set layerMatched [string match "$spec" $wireLayer]
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 			if {$layerMatched} {
[05/05 22:20:18    554s] 				if {$vars(got_show_layers) == 0} {
[05/05 22:20:18    554s] 					array unset vars show_layers_lsw_layers,*
[05/05 22:20:18    554s] 					set vars(show_layers_lsw_is_current) 1
[05/05 22:20:18    554s] 					foreach tmpLayer $metalLayers {
[05/05 22:20:18    554s] 						# First hide all layers; we only do that after we are sure we have
[05/05 22:20:18    554s] 						# at least one layer which should be shown.
[05/05 22:20:18    554s] 						setLayerPreference $tmpLayer -isVisible 0
[05/05 22:20:18    554s] 					}
[05/05 22:20:18    554s] 					set vars(got_show_layers) 1
[05/05 22:20:18    554s] 				}
[05/05 22:20:18    554s] 				setLayerPreference $layer -isVisible 1
[05/05 22:20:18    554s] 				# record the show layers
[05/05 22:20:18    554s] 				set vars(show_layers_lsw_layers,$layer) 1
[05/05 22:20:18    554s] 				break
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_is_lsw_layers_saved {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	set lNames [array names vars lsw_layers,*]
[05/05 22:20:18    554s] 	if { [llength $lNames]<=0 } {
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		return 1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_record_lsw_layers {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set metalLayers [mgc_rve_get_all_metal_layers]
[05/05 22:20:18    554s] 	foreach layer $metalLayers {
[05/05 22:20:18    554s] 		set isVisible [getLayerPreference $layer -isVisible]
[05/05 22:20:18    554s] 		set vars(lsw_layers,$layer) $isVisible 
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_restore_lsw_layers {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set lNames [array names vars lsw_layers,*]
[05/05 22:20:18    554s] 	set metalLayers [string map [list "lsw_layers," ""] $lNames]
[05/05 22:20:18    554s] 	foreach layer $metalLayers {
[05/05 22:20:18    554s] 		set isVisible $vars(lsw_layers,$layer)
[05/05 22:20:18    554s] 		# realtime/innovus-common-ui/capture_restore_layer_visibility
[05/05 22:20:18    554s] 		# NOK: get_layer_preference allM3Cont -is_visible => 2
[05/05 22:20:18    554s] 		# if { $isVisible } { set isVisible 1 }
[05/05 22:20:18    554s] 		# set_layer_preference M3Cont -is_visible 0
[05/05 22:20:18    554s] 		# => set_layer_preference allM3Cont -is_visible 2
[05/05 22:20:18    554s] 		# CUI mode only allow {0 1} as value for -is_visible, while legacy mode allow {0 1 2}.
[05/05 22:20:18    554s] 		# the value of 2 must have some special undocumented meaning.
[05/05 22:20:18    554s] 		if { $isVisible==2 && [is_common_ui_mode] } {
[05/05 22:20:18    554s] 			eval_legacy "setLayerPreference $layer -isVisible $isVisible"
[05/05 22:20:18    554s] 		} else {
[05/05 22:20:18    554s] 			setLayerPreference $layer -isVisible $isVisible
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_restore_show_layers_lsw_layers {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set lNames [array names vars show_layers_lsw_layers,*]
[05/05 22:20:18    554s] 	if { [llength $lNames]>0 } {
[05/05 22:20:18    554s] 		set metalLayers [mgc_rve_get_all_metal_layers]
[05/05 22:20:18    554s] 		foreach tmpLayer $metalLayers {
[05/05 22:20:18    554s] 			setLayerPreference $tmpLayer -isVisible 0
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		set lswLayers [string map [list "show_layers_lsw_layers," ""] $lNames]
[05/05 22:20:18    554s] 		foreach layer $lswLayers {
[05/05 22:20:18    554s] 			setLayerPreference $layer -isVisible 1
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		set vars(show_layers_lsw_is_current) 1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_toggle_visible_layer_set {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if { $vars(show_layers_lsw_is_current) } {
[05/05 22:20:18    554s] 		mgc_rve_restore_lsw_layers
[05/05 22:20:18    554s] 		set vars(show_layers_lsw_is_current) 0
[05/05 22:20:18    554s] 		redraw
[05/05 22:20:18    554s] 	} elseif { [array names vars show_layers_lsw_layers,*]!="" } {
[05/05 22:20:18    554s] 		mgc_rve_restore_show_layers_lsw_layers
[05/05 22:20:18    554s] 		set vars(show_layers_lsw_is_current) 1
[05/05 22:20:18    554s] 		redraw
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] ################################################################################
[05/05 22:20:18    554s] ################################################################################
[05/05 22:20:18    554s] ################################################################################
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] ################################################################################
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::setupLayoutExport {} {
[05/05 22:20:18    554s] 	mgc_enc::ShowNote \
[05/05 22:20:18    554s] "Calibre uses the Encounter streamOut
[05/05 22:20:18    554s] command to export layout."
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::setupNetlistExport {} {
[05/05 22:20:18    554s] 	mgc_enc::ShowNote \
[05/05 22:20:18    554s] "Calibre uses the Encounter saveNetlist
[05/05 22:20:18    554s] command to export netlists."
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::DisplayFileContents {w fname} {
[05/05 22:20:18    554s] 	global _ui_fonts
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {![winfo exists $w.txtf]} {
[05/05 22:20:18    554s] 		set txt [uiutils_MakeScrolledText $w.txtf "both" -font $_ui_fonts(Mono) -wrap none -relief flat -height 40]
[05/05 22:20:18    554s] 		pack $w.txtf -side top -fill both -expand 1
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		set txt $w.txtf.txt
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	$txt config -state normal	
[05/05 22:20:18    554s] 	$txt delete 1.0 end
[05/05 22:20:18    554s] 	set af [open $fname r]
[05/05 22:20:18    554s] 	$txt insert end [read $af]
[05/05 22:20:18    554s] 	close $af
[05/05 22:20:18    554s] 	$txt config -state disabled
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::setupAboutDialog {} {
[05/05 22:20:18    554s] 	global env _ui_fonts
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set twin ".twin"
[05/05 22:20:18    554s] 	if {[winfo exists $twin]} {
[05/05 22:20:18    554s] 		wm deiconify $twin
[05/05 22:20:18    554s] 		raise $twin
[05/05 22:20:18    554s] 		return #t
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set afile [file join $env(MGC_HOME) shared pkgs icv tools queryenc calencREADME]
[05/05 22:20:18    554s] 	if {![file exists $afile] || ![file readable $afile]} {
[05/05 22:20:18    554s] 		uimessage_Note . "Could not read information file:\n\$MGC_HOME/shared/pkgs/icv/tools/queryenc/calencREADME"
[05/05 22:20:18    554s] 		return #t
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	toplevel $twin
[05/05 22:20:18    554s] 	wm withdraw $twin
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	wm protocol $twin WM_DELETE_WINDOW "wm withdraw $twin"
[05/05 22:20:18    554s] 	bind $twin <Escape> "wm withdraw $twin"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vfile [file join $env(MGC_HOME) pkgs icv dependencies version]
[05/05 22:20:18    554s] 	set vtext ""
[05/05 22:20:18    554s] 	if {[catch {set vf [open $vfile r]}]==0} {
[05/05 22:20:18    554s] 		gets $vf vtext
[05/05 22:20:18    554s] 		close $vf
[05/05 22:20:18    554s] 		set vtext "($vtext)"
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	wm title $twin "About the Calibre Encounter/Innovus Interface $vtext"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	DisplayFileContents $twin $afile
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	#uiprocs_PositionWindow $twin . "center"
[05/05 22:20:18    554s] 	mgc_enc::PositionWindowOnRight $twin
[05/05 22:20:18    554s] 	
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] ################################################################################
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CheckEnv {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	global env
[05/05 22:20:18    554s] 	if {![info exists env(MGC_HOME)] || $env(MGC_HOME)==""} {
[05/05 22:20:18    554s] 		ShowError "MGC_HOME environment variable is not set!"
[05/05 22:20:18    554s] 		return ""
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	initServerSocket $vars(socket_number) $vars(socket_host)
[05/05 22:20:18    554s] 	return [file join $env(MGC_HOME) "bin" "calibre"]
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::StartGUI {cmd cell type} {
[05/05 22:20:18    554s]     variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     append cmd " -gui -${type}"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set doTriggerSetup 1
[05/05 22:20:18    554s]     if {$type eq "rve"} {
[05/05 22:20:18    554s]         set doTriggerSetup 0
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     if {$doTriggerSetup} {
[05/05 22:20:18    554s]         set key [calculateTriggerKey]
[05/05 22:20:18    554s]         set ::env(MGC_CALIBRE_INTERACTIVE_TRIGGER_KEY) $key
[05/05 22:20:18    554s]         lappend vars(CI_trigger_keys) $key
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set retVal ""
[05/05 22:20:18    554s]     if {[catch {set fid [open "| $cmd" "r+"]} emsg]==0} {
[05/05 22:20:18    554s]         fconfigure $fid -buffering line -blocking 0
[05/05 22:20:18    554s]         fileevent $fid readable "mgc_enc::ReadGUI $fid $cell $type"
[05/05 22:20:18    554s]         set vars($type,$cell) $fid
[05/05 22:20:18    554s]         set retVal $fid
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if {$doTriggerSetup} {
[05/05 22:20:18    554s]         unset ::env(MGC_CALIBRE_INTERACTIVE_TRIGGER_KEY)
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     return $retVal
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::ReadGUI {fid cell type {cmd ""}} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	read $fid
[05/05 22:20:18    554s] 	if {[eof $fid]} {
[05/05 22:20:18    554s] 		fconfigure $fid -blocking 1
[05/05 22:20:18    554s] 		catch {close $fid}
[05/05 22:20:18    554s] 		if {$cmd ne ""} {
[05/05 22:20:18    554s] 		    # need to specify $cmd for custom
[05/05 22:20:18    554s] 		    set vars($type,$cmd,$cell) ""
[05/05 22:20:18    554s] 		} else {
[05/05 22:20:18    554s] 		    set vars($type,$cell) ""
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] # Check if the process associated with the with the cell and tool type (drc, lvs, etc) has already been started
[05/05 22:20:18    554s] # For a custom menu item, the third param "cmd" must be specified
[05/05 22:20:18    554s] @proc mgc_enc::CheckGUI {cell type {cmd ""}} {
[05/05 22:20:18    554s] 	variable vars
