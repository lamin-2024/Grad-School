[05/05 22:20:18    554s] @file 10:
[05/05 22:20:18    554s] @file 11: proc mgc_enc_is_common_ui_mode {} {
[05/05 22:20:18    554s]   set isCuiMode 0
[05/05 22:20:18    554s]   if { [info exists ::env(MGC_CALIBRE_INNOVUS_CUI_MODE)] && $::env(MGC_CALIBRE_INNOVUS_CUI_MODE)=="1298096" } {
[05/05 22:20:18    554s]     if { [info commands eval_legacy] == "eval_legacy" } {
[05/05 22:20:18    554s]       set isCuiMode 1
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]   }
[05/05 22:20:18    554s]   return $isCuiMode
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] @file 20:
[05/05 22:20:18    554s] @file 21: proc mgc_load_calibre {} {
[05/05 22:20:18    554s]   global env
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]   if {[info exists env(CALIBRE_HOME)] && ($env(CALIBRE_HOME) != "")} {
[05/05 22:20:18    554s]     set env(MGC_HOME) $env(CALIBRE_HOME)
[05/05 22:20:18    554s]   }
[05/05 22:20:18    554s]   if {![info exists env(MGC_HOME)] || $env(MGC_HOME)==""} {
[05/05 22:20:18    554s]     puts "//   *** Environment variable CALIBRE_HOME or MGC_HOME must be set. ***"
[05/05 22:20:18    554s]     puts "//   *** Calibre interface NOT loaded. ***"
[05/05 22:20:18    554s]     return 0
[05/05 22:20:18    554s]   }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]   set etclf [file join $env(MGC_HOME) lib cal_innovus.tcl]
[05/05 22:20:18    554s]   if { ![file readable $etclf] } {
[05/05 22:20:18    554s]     puts "//   *** Could not read Calibre interface files. ***"
[05/05 22:20:18    554s]     puts "//   *** Calibre interface NOT loaded. ***"
[05/05 22:20:18    554s]     return 0
[05/05 22:20:18    554s]   }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]   if { [info commands eval_legacy]=="eval_legacy" && ![mgc_enc_is_common_ui_mode] } {
[05/05 22:20:18    554s]     eval_legacy "proc mgc_enc_is_common_ui_mode {} { return 0 }"
[05/05 22:20:18    554s]     if { [catch {eval_legacy "source -quiet $etclf"} msg] } {
[05/05 22:20:18    554s]       puts "//  ERROR while loading Calibre interface: $msg"
[05/05 22:20:18    554s]       return 0
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]   } else {
[05/05 22:20:18    554s]     set opt ""
[05/05 22:20:18    554s]     if { [mgc_enc_is_common_ui_mode] } {
[05/05 22:20:18    554s]       set opt "-quiet"
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if { [catch "source $opt $etclf" msg] } {
[05/05 22:20:18    554s]       puts "//  ERROR while loading Calibre interface: $msg"
[05/05 22:20:18    554s]       return 0
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]   }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]   return 1
[05/05 22:20:18    554s] }
