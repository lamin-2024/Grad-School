[05/05 22:20:18    554s] 		foreach arg $legacyArgs {
[05/05 22:20:18    554s] 			lappend newArgs [string map $map $arg]
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		return $newArgs
[05/05 22:20:18    554s] 	}
