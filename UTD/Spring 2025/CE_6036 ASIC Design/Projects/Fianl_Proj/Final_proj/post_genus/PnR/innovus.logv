[05/05 22:20:18    554s] 	proc mgc_enc::getLayerByName {layerName} {
[05/05 22:20:18    554s] 		# realtime/innovus-common-ui/cto_file_layer_visibility
[05/05 22:20:18    554s] 		# with edi_tcl_flow_half_adder in CUI mode:
[05/05 22:20:18    554s] 		#    OK: eval_legacy "dbGetLayerByName M0" => 0x7faf0f2ce800
[05/05 22:20:18    554s] 		#   NOK: get_db layers -if { .name=="M0" } => ""
[05/05 22:20:18    554s] 		# see also ::calibre::realtime::getLayerByName
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		return [eval_legacy "dbGetLayerByName $layerName"]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		if { 0 } {
[05/05 22:20:18    554s] 			set layers [get_all_layers metal]
[05/05 22:20:18    554s] 			set layer [get_db layers -if { .name==$layerName }]
[05/05 22:20:18    554s] 			if { $layer=="" } {
[05/05 22:20:18    554s] 				set layer 0
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 			return $layer
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
