[05/05 22:20:18    554s] # This contains Tcl procs specific to integration of ICCompiler and EDI with RVE and Calibre
[05/05 22:20:18    554s] # Interactive for creating DRC markers and route guides/blockages.
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @if {[info exists env(CALIBRE_HOME)] && ($env(CALIBRE_HOME) != "")} {
[05/05 22:20:18    554s]     set env(MGC_HOME) $env(CALIBRE_HOME)
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @namespace eval Calibre::import_rdb {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     namespace export *
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     ################################################################################
[05/05 22:20:18    554s]     # Parse the list of arguments into an array
[05/05 22:20:18    554s]     ################################################################################
[05/05 22:20:18    554s]     proc ParseArguments { argList } {
[05/05 22:20:18    554s]       array set retArguments {}
[05/05 22:20:18    554s]       set standAloneArgIdx 0
[05/05 22:20:18    554s]       set argListLength [llength $argList]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       for {set argIndex 0} {$argIndex < $argListLength} {incr argIndex} {
[05/05 22:20:18    554s]         set thisArgument [lindex $argList $argIndex]
[05/05 22:20:18    554s]         if { ([string index $thisArgument 0] eq "-") && (![string is digit [string index $thisArgument 1]]) } {
[05/05 22:20:18    554s]           # This arg is a switch
[05/05 22:20:18    554s]           if { [expr {$argIndex+1}] < $argListLength } {
[05/05 22:20:18    554s]             # Check next argument
[05/05 22:20:18    554s]             set nextArgument [lindex $argList [expr {$argIndex+1}]]
[05/05 22:20:18    554s]             if { ([string index $nextArgument 0] ne "-") || ([string is digit [string index $nextArgument 1]]) } {
[05/05 22:20:18    554s]               set retArguments($thisArgument) $nextArgument
[05/05 22:20:18    554s]               incr argIndex
[05/05 22:20:18    554s]               continue
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]           }
[05/05 22:20:18    554s]           # This arg is a flag
[05/05 22:20:18    554s]           set retArguments($thisArgument) ""
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]           # This arg is a stand-alone argument
[05/05 22:20:18    554s]           set retArguments($standAloneArgIdx) $thisArgument
[05/05 22:20:18    554s]           incr standAloneArgIdx
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       return [array get retArguments]
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] ### End verbose source output for '/proj/cad/mentor_2021/aoi_cal_2021.1_33.19/shared/pkgs/icv/tools/querytcl/import_rdb.tcl'.
