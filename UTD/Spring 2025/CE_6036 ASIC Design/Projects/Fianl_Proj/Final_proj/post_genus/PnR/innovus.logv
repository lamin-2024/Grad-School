[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_get_location {cell precision} {
[05/05 22:20:18    554s] 	set pt [guiGetCoord]
[05/05 22:20:18    554s] 	if { [llength $pt]==2 } {
[05/05 22:20:18    554s] 		SendCmdToClient layout_data_ready [lindex $pt 0] [lindex $pt 1]
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		SendCmdToClient layout_data_ready
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_get_rectangle {cell precision} {
[05/05 22:20:18    554s] 	set box [guiGetBox]
[05/05 22:20:18    554s] 	if { [llength $box]==4 } {
[05/05 22:20:18    554s] 		SendCmdToClient layout_data_ready [lindex $box 0] [lindex $box 1] [lindex $box 2] [lindex $box 3]
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		SendCmdToClient layout_data_ready
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_get_poly {cell precision} {
[05/05 22:20:18    554s] 	set poly [guiGetPoly]
[05/05 22:20:18    554s] 	if { [llength $poly]>1 } {
[05/05 22:20:18    554s] 		# eval to flatten the list
[05/05 22:20:18    554s] 		eval SendCmdToClient layout_data_ready $poly
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		SendCmdToClient layout_data_ready
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_import {fname lname} {
[05/05 22:20:18    554s] 	ShowNote "Functionality not implemented."
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
