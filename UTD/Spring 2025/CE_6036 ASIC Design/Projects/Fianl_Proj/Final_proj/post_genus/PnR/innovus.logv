[05/05 22:20:18    554s] @proc mgc_enc::DesignLoaded {{show_msg 0}} {
[05/05 22:20:18    554s] 	if {[getTopCell]==0} {
[05/05 22:20:18    554s] 		if {$show_msg} {
[05/05 22:20:18    554s] 			mgc_enc::ShowNote "No design loaded!"
[05/05 22:20:18    554s] 		} else {
[05/05 22:20:18    554s] 			error "No design loaded!"
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CheckCellMapping {rvecell editcell msg} {
[05/05 22:20:18    554s] 	variable cmap
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set map_cell $rvecell
[05/05 22:20:18    554s] 	if {[info exists cmap($rvecell)]} {
[05/05 22:20:18    554s] 		set map_cell $cmap($rvecell)
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {[string compare $map_cell $editcell]} {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		if {![uimessage_YesNo . $msg]} {
[05/05 22:20:18    554s] 			return 0
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		set cmap($rvecell) $editcell
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CheckHighlightContext {fname editcell {is_import 0}} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set f [open $fname r]
[05/05 22:20:18    554s] 	set line1 [split [gets $f]]
[05/05 22:20:18    554s] 	set line2 [gets $f]
[05/05 22:20:18    554s] 	close $f
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {[string compare [lindex $line1 0] "mgc_rve_context"]==0} {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		set fcell [string trim [lindex $line1 1] "\""]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		if {$is_import} {
[05/05 22:20:18    554s] 			set msg "Import data from RVE cell \"${fcell}\"\ninto Encounter cell \"${editcell}\"?"
[05/05 22:20:18    554s] 		} else {
[05/05 22:20:18    554s] 			set msg "Show highlights from RVE cell \"${fcell}\"\nin Encounter cell \"${editcell}\"?"
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		if {![CheckCellMapping $fcell $editcell $msg]} {
[05/05 22:20:18    554s] 			return [SetReturnVal 0]
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {!$is_import} {
[05/05 22:20:18    554s] 		set reset 0
[05/05 22:20:18    554s] 		if {$line2=="mgc_rve_delete_markers"} {
[05/05 22:20:18    554s] 			set reset 1
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		setHighlightColor $reset
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return [SetReturnVal 1]
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CheckExportContext {rvecell editcell} {
[05/05 22:20:18    554s] 	if {![CheckCellMapping $rvecell $editcell "Export Encounter cell \"${editcell}\"\nas Calibre cell \"${rvecell}\"?"]} {
[05/05 22:20:18    554s] 		return [SetReturnVal 0]
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return [SetReturnVal 1]
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CloseClientSockets {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	foreach client_sid $vars(client_sockets) {
[05/05 22:20:18    554s] 		if {$client_sid!=""} {
[05/05 22:20:18    554s] 			close $client_sid
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	set vars(client_sockets) {}
[05/05 22:20:18    554s] 	set vars(last_client_sid) ""
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CloseClientSocket {cid} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	close $cid
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set newlist {}
[05/05 22:20:18    554s] 	foreach client_sid $vars(client_sockets) {
[05/05 22:20:18    554s] 		if {$client_sid!=$cid} {
[05/05 22:20:18    554s] 			lappend newlist $client_sid
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	set vars(client_sockets) $newlist
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {$cid==$vars(last_client_sid)} {
[05/05 22:20:18    554s] 		set vars(last_client_sid) ""
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CloseServerSocket {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	if {$vars(server_sid)!=""} {
[05/05 22:20:18    554s] 		close $vars(server_sid)
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	set vars(server_sid) ""
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CloseServer {} {
[05/05 22:20:18    554s] 	CloseClientSockets
[05/05 22:20:18    554s] 	CloseServerSocket
[05/05 22:20:18    554s] 	exit 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::AutoSeekSocket {{host ""}} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	
[05/05 22:20:18    554s] 	set s_start $vars(SRANGE_START)
[05/05 22:20:18    554s] 	set s_end   $vars(SRANGE_END)
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set host [string trim $host]
[05/05 22:20:18    554s] 	set retval 1
[05/05 22:20:18    554s] 	for {set i $s_start} {$i <= $s_end} {incr i} {
[05/05 22:20:18    554s] 	    if { $host eq "" } {
[05/05 22:20:18    554s] 		if { [IsPortAvailable $i] } {
[05/05 22:20:18    554s] 			set retval [catch {socket -server mgc_enc::AcceptConnection $i} vars(server_sid)]
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	    } else {
[05/05 22:20:18    554s] 		set retval [catch {socket -myaddr $host -server mgc_enc::AcceptConnection $i} vars(server_sid)]
[05/05 22:20:18    554s] 	    }
[05/05 22:20:18    554s] 	    if { $retval==0 } { return $i }
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(server_sid) ""
[05/05 22:20:18    554s] 	if { $host eq "" } { set host "localhost" }
[05/05 22:20:18    554s] 	set msg "Could not initialize layout server socket\non $host at any port between $s_start and $s_end.\n\nPlease specify a different socket number or host name\nby using the command:\n\nmgc_enc::initServerSocket <port_number> \[host_name\]\n"
[05/05 22:20:18    554s] 	if { [info exists ::env(MGC_REALTIME_INNOVUS_ENABLED)] } {
[05/05 22:20:18    554s] 		append msg "\nRealTime will be disabled!"
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	ShowError $msg
[05/05 22:20:18    554s] 	return 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] #-------------------------------------------------------------------------------
[05/05 22:20:18    554s] # DR1273859/1374383/1376672: Need to ensure no other socket connection is listening on network addresses for this port
[05/05 22:20:18    554s] #-------------------------------------------------------------------------------
[05/05 22:20:18    554s] @proc mgc_enc::IsPortAvailable {portNum} {
[05/05 22:20:18    554s] 	set netaddr "127.0.0.1"   ;# not localhost as this may resolve to ipv6 ::1 and successfully connect when 127.0.0.1:port is in use
[05/05 22:20:18    554s] 	set retval [catch {socket -myaddr $netaddr -server mgc_enc::AcceptConnection $portNum} sid]
[05/05 22:20:18    554s] 	if { $retval==0 } {
[05/05 22:20:18    554s] 		close $sid
[05/05 22:20:18    554s] 		set retval [catch {socket -myaddr [info hostname] -server mgc_enc::AcceptConnection $portNum} sid]
[05/05 22:20:18    554s] 		if { $retval==0 } {
[05/05 22:20:18    554s] 			close $sid
[05/05 22:20:18    554s] 			return 1
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::OnServerChangeEvent {PreOrPost host portNum} {
[05/05 22:20:18    554s] 	if { [info exists ::env(MGC_REALTIME_INNOVUS_ENABLED)] } {
[05/05 22:20:18    554s] 		if { [info procs ::calibre::realtime::${PreOrPost}EncServerChangeEvent]!="" } {
[05/05 22:20:18    554s] 			::calibre::realtime::${PreOrPost}EncServerChangeEvent $host $portNum
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::CreateServerSocket {portNum {host ""} {autoSeek 1}} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	global env
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if { $portNum=="" || [regexp "\[^0-9\]+" $portNum] } {
[05/05 22:20:18    554s] 		ShowError "Invalid port-number specified ($portNum)."
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	# Notify RealTime server to prevent it from exiting.
[05/05 22:20:18    554s] 	OnServerChangeEvent "Pre" $vars(socket_host) $vars(socket_number)
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	CloseClientSockets
[05/05 22:20:18    554s] 	CloseServerSocket
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set announce_number 0
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set host [string trim $host]
[05/05 22:20:18    554s] 	set retval 1
[05/05 22:20:18    554s] 	if { $host eq "" } {
[05/05 22:20:18    554s] 		if { [IsPortAvailable $portNum] } {
[05/05 22:20:18    554s] 			set retval [catch {socket -server mgc_enc::AcceptConnection $portNum} vars(server_sid)]
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		set retval [catch {socket -myaddr $host -server mgc_enc::AcceptConnection $portNum} vars(server_sid)]
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	if {$retval} {
[05/05 22:20:18    554s] 		set vars(server_sid) ""
[05/05 22:20:18    554s] 		if {!$autoSeek} {
[05/05 22:20:18    554s] 			set msg "Could not initialize layout server socket\nat $host:$portNum.\n\nPlease specify a different socket number or host name\nby using the command:\n\nmgc_enc::initServerSocket <port_number> \[host_name\]\n"
[05/05 22:20:18    554s] 			if { [info exists ::env(MGC_REALTIME_INNOVUS_ENABLED)] } {
[05/05 22:20:18    554s] 				append msg "\nRealTime will be disabled!"
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 			ShowError $msg
[05/05 22:20:18    554s] 			OnServerChangeEvent "Post" $vars(socket_host) $vars(socket_number)
[05/05 22:20:18    554s] 			return 0
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		set msg "Could not initialize Calibre layout-server socket at $host:$portNum. Trying to find free socket ..."
[05/05 22:20:18    554s] 		TranscriptMessage $msg
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		set portNum [AutoSeekSocket $host]
[05/05 22:20:18    554s] 		if {$portNum==0} {
[05/05 22:20:18    554s] 			OnServerChangeEvent "Post" $vars(socket_host) $vars(socket_number)
[05/05 22:20:18    554s] 			return 0
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		set announce_number 1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if { $host eq "" } {
[05/05 22:20:18    554s] 	    set msg "Calibre layout-server initialized successfully at socket localhost:$portNum"
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 	    set msg "Calibre layout-server initialized successfully at socket $host:$portNum"
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	TranscriptMessage $msg
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set env($vars(ENV_VARNAME)) "$host:$portNum"
[05/05 22:20:18    554s] 	if { ![info exists env(MGC_CALIBRE_SCHEMATIC_SERVER)] } {
[05/05 22:20:18    554s] 	    set env(MGC_CALIBRE_SCHEMATIC_SERVER) "$host:$portNum"
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	set vars(socket_host) $host
[05/05 22:20:18    554s] 	set vars(socket_number) $portNum
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	# ER1202567: Innovus RealTime Step 1: Create Infrastructures
[05/05 22:20:18    554s] 	OnServerChangeEvent "Post" $vars(socket_host) $vars(socket_number)
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::GetDefaultSocket {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	global env
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set host ""
[05/05 22:20:18    554s] 	if {[info exists env($vars(ENV_VARNAME))]} {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		set layout_env $env($vars(ENV_VARNAME))
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		if {$layout_env==""} {
[05/05 22:20:18    554s] 			# don't initialize the server socket!
[05/05 22:20:18    554s] 			set msg "Environment variable MGC_CALIBRE_LAYOUT_SERVER is set to blank."
[05/05 22:20:18    554s] 			TranscriptMessage $msg
[05/05 22:20:18    554s] 			return 0
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		set colon_index [string first ":" $layout_env]
[05/05 22:20:18    554s]         if {$colon_index==-1} {
[05/05 22:20:18    554s]             set layout_port $layout_env
[05/05 22:20:18    554s]         } elseif {$colon_index==0} {
[05/05 22:20:18    554s]             set layout_port [string range $layout_env 1 end]
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             set host [string range $layout_env 0 [expr {$colon_index-1}]]
[05/05 22:20:18    554s]             set layout_port [string range $layout_env [expr {$colon_index+1}] end]
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		if { $layout_port=="" || [regexp "\[^0-9\]+" $layout_port] } {
[05/05 22:20:18    554s] 			set msg "Invalid port-number specified ($layout_port).\nPlease set environment-variable\n$vars(ENV_VARNAME)\nto <hostname>:<socket number>."
[05/05 22:20:18    554s] 			ShowError $msg
[05/05 22:20:18    554s] 			return -1
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		
[05/05 22:20:18    554s] 		return [list $host $layout_port]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		return [list $host $vars(DEFAULT_PORT)]
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::initServerSocket {{portNum ""} {host ""}} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set autoSeek 0
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if { $vars(socket_number)==$portNum && $vars(socket_host)==$host && $vars(server_sid)!="" } {
[05/05 22:20:18    554s] 		return 1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {$portNum=="" || $portNum<=0} {
[05/05 22:20:18    554s] 		set lHostPort [GetDefaultSocket]
[05/05 22:20:18    554s] 		set host    [lindex $lHostPort 0]
[05/05 22:20:18    554s] 		set portNum [lindex $lHostPort 1]
[05/05 22:20:18    554s] 		if {$portNum<=0} {
[05/05 22:20:18    554s] 			# either don't init socket or error in port specification
[05/05 22:20:18    554s] 			return 0
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		set autoSeek 1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return [CreateServerSocket $portNum $host $autoSeek]
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::AcceptConnection {cid addr port} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	fileevent $cid readable "mgc_enc::ProcessClientInput $cid"
[05/05 22:20:18    554s] 	fconfigure $cid -buffering line -blocking 0
[05/05 22:20:18    554s] 	set vars(last_client_sid) $cid
[05/05 22:20:18    554s] 	lappend vars(client_sockets) $cid
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     # Initial acceptance notification
[05/05 22:20:18    554s]     set lElem [fconfigure $cid -sockname]
[05/05 22:20:18    554s]     set hostName [lindex $lElem 1]
[05/05 22:20:18    554s]     set portNum  [lindex $lElem 2]
[05/05 22:20:18    554s]     if { $hostName=="localhost" || $hostName=="localhost.localdomain" } {
[05/05 22:20:18    554s]         set hostName [info hostname] ;# do NOT use localhost as hostName, it doesn't work across different machines
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set viewerName Cadence:Encounter
[05/05 22:20:18    554s]     set display [getDisplayEnvVar]
[05/05 22:20:18    554s]     set featureList "language Tcl runcode $vars(runcode_version)"
[05/05 22:20:18    554s]     foreach cmd $vars(optionalCommands) {
[05/05 22:20:18    554s]         append featureList " $cmd 1"
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     eval SendCmdToClient viewer_connected $hostName $portNum $display $viewerName $vars(protocol_version) $featureList
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::calculateTriggerKey {} {
[05/05 22:20:18    554s]     set key [clock seconds]
[05/05 22:20:18    554s]     set mod [expr {$key%10000}]
[05/05 22:20:18    554s]     set key [string range [expr {$key-([pid]*$mod)}] 4 end]
[05/05 22:20:18    554s]     return $key
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] # handles client communication: processes input received from RVE
[05/05 22:20:18    554s] @proc mgc_enc::ProcessClientInput {cid} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {[gets $cid request] < 0} {
[05/05 22:20:18    554s] 		if { [eof $cid] } {
[05/05 22:20:18    554s] 			CloseClientSocket $cid
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		# process the incoming request
[05/05 22:20:18    554s] 		set old_socket $vars(last_client_sid)
[05/05 22:20:18    554s] 		# ProcessCmd can cause us to try to send something across
[05/05 22:20:18    554s] 		# the socket.  Make sure we talk to the right socket.
[05/05 22:20:18    554s] 		set vars(last_client_sid) $cid
[05/05 22:20:18    554s] 		# 1st send the incoming request to RealTime server
[05/05 22:20:18    554s] 		if {[info exists ::env(MGC_REALTIME_INNOVUS_ENABLED)]} {
[05/05 22:20:18    554s] 			if { [ProcessRealTimeInput $cid $request] } {
[05/05 22:20:18    554s] 				return
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 		if {[ProcessCmd $request]} {
[05/05 22:20:18    554s] 			#set vars(last_client_sid) $cid
[05/05 22:20:18    554s] 		} else {
[05/05 22:20:18    554s] 			set vars(last_client_sid) $old_socket
[05/05 22:20:18    554s] 			ShowError "Invalid command: \"$request\""
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::ProcessRealTimeInput {cid request} {
[05/05 22:20:18    554s] 	# DR1280729: Virtuoso using 100% CPU caused by Mentor's Calibre not able to handle infosec security scan
[05/05 22:20:18    554s] 	# direct usage of [lindex $requst 0] with invalid input can cause Tcl error,
[05/05 22:20:18    554s] 	# set request "R.7 {@ At least 8 OVL_PO_ODs and 8 OVL_CO_POs for 1X1 Die}" ;# remove closing brace 
[05/05 22:20:18    554s] 	#   lindex $request 0 => unmatched open brace in list
[05/05 22:20:18    554s] 	# split can avoid such issue.
[05/05 22:20:18    554s] 	#   split $request => R.7 \{@ At least 8 OVL_PO_ODs and 8 OVL_CO_POs for 1X1 Die
[05/05 22:20:18    554s] 	set lCmds [split $request]
[05/05 22:20:18    554s] 	set cmd [lindex $lCmds 0]
[05/05 22:20:18    554s] 	# ? matches zero or one instance of previous pattern
[05/05 22:20:18    554s] 	# regexp {^(::)?calibre::realtime::*}   calibre::realtime::cmd => 1
[05/05 22:20:18    554s] 	# regexp {^(::)?calibre::realtime::*} ::calibre::realtime::cmd => 1
[05/05 22:20:18    554s] 	# regexp {^(::)?calibre::realtime::*}  :calibre::realtime::cmd => 0
[05/05 22:20:18    554s] 	if { [regexp {^(::)?calibre::realtime::*} $cmd] } {
[05/05 22:20:18    554s] 		# re-directed to RealTime Tcl code
[05/05 22:20:18    554s] 		# Typically, the cmd is ::calibre::realtime::CmdDispatcher
[05/05 22:20:18    554s] 		eval $cmd $cid [lrange $request 1 end]
[05/05 22:20:18    554s] 		return 1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::ProcessCmd {in_cmd} {
[05/05 22:20:18    554s] #	puts stdout "RVE: $in_cmd"
[05/05 22:20:18    554s] 	set cmd [split $in_cmd]
[05/05 22:20:18    554s] 	set c1 [lindex $cmd 0]
[05/05 22:20:18    554s] 	set rve_signature "mgc_rve_*"
[05/05 22:20:18    554s] 	if {[string match $rve_signature $c1]} {
[05/05 22:20:18    554s] 		return [ProcessRveCmd $in_cmd]
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		puts stdout "RVE: Rejecting unknown command"
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::ProcessRveCmd {cmdl} {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set cmd [lindex $cmdl 0]
[05/05 22:20:18    554s] 	set args [lrange $cmdl 1 end]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	switch -- $cmd {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		"mgc_rve_rfile"	{
[05/05 22:20:18    554s] 			if {[llength $args]==1} {
[05/05 22:20:18    554s] 				set fname [lindex $args 0]
[05/05 22:20:18    554s] 			    return [$cmd $fname]
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		"mgc_rve_delete_markers" {
[05/05 22:20:18    554s] 			switch [llength $args] {
[05/05 22:20:18    554s] 				0 {
[05/05 22:20:18    554s] 					return [$cmd]
[05/05 22:20:18    554s] 				}
[05/05 22:20:18    554s] 				1 {
[05/05 22:20:18    554s] 				    return [eval $cmd [lindex $args 0]]
[05/05 22:20:18    554s] 				}
[05/05 22:20:18    554s] 				2 {
[05/05 22:20:18    554s] 					if {[CheckInteger [lindex $args 1]]} {
[05/05 22:20:18    554s] 						return [eval $cmd [lindex $args 0] [lindex $args 1]]
[05/05 22:20:18    554s] 					}
[05/05 22:20:18    554s] 				}
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		"mgc_rve_get_location" -
[05/05 22:20:18    554s] 		"mgc_rve_get_rectangle" -
[05/05 22:20:18    554s] 		"mgc_rve_get_poly" -
[05/05 22:20:18    554s] 		"mgc_rve_context" {
[05/05 22:20:18    554s] 			if {[llength $args]==2} {
[05/05 22:20:18    554s] 				set cell [lindex $args 0]
[05/05 22:20:18    554s] 				set precision [lindex $args 1]
[05/05 22:20:18    554s] 				if {[CheckInteger $precision]} {
[05/05 22:20:18    554s] 					return [$cmd $cell $precision]
[05/05 22:20:18    554s] 				}
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		"mgc_rve_zoom" {
[05/05 22:20:18    554s] 			if {[llength $args]==5} {
[05/05 22:20:18    554s] 				set llx [lindex $args 0]
[05/05 22:20:18    554s] 				set lly [lindex $args 1]
[05/05 22:20:18    554s] 				set urx [lindex $args 2]
[05/05 22:20:18    554s] 				set ury [lindex $args 3]
[05/05 22:20:18    554s] 				set zf  [lindex $args 4]
[05/05 22:20:18    554s] 				if {[CheckNumber $llx] && [CheckNumber $lly] && [CheckNumber $urx] && [CheckNumber $ury] && [CheckNumber $zf]} {
[05/05 22:20:18    554s] 					return [$cmd $llx $lly $urx $ury $zf]
[05/05 22:20:18    554s] 				}
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		"mgc_rve_snet" -
[05/05 22:20:18    554s] 		"mgc_rve_sinst" {
[05/05 22:20:18    554s] 			if {[llength $args]>=4} {
[05/05 22:20:18    554s] 				set cell [lindex $args 0]
[05/05 22:20:18    554s] 				set clear_hl [lindex $args 1]
[05/05 22:20:18    554s] 				set zfactor [lindex $args 2]
[05/05 22:20:18    554s] 				set nets [lrange $args 3 end]
[05/05 22:20:18    554s] 				if {[CheckNumber $zfactor] && [CheckInteger $clear_hl]} {
[05/05 22:20:18    554s] 					return [$cmd $cell $clear_hl $zfactor $nets]
[05/05 22:20:18    554s] 				}
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		"mgc_rve_probe_snet" -
[05/05 22:20:18    554s] 		"mgc_rve_probe_sinst" {
[05/05 22:20:18    554s] 			if {([llength $args]==1)} {
[05/05 22:20:18    554s] 				return [$cmd [lindex $args 0]]
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		"mgc_rve_export_layout" {
[05/05 22:20:18    554s] 			set alen [llength $args]
[05/05 22:20:18    554s] 			if {$alen==3 || $alen==7} {
[05/05 22:20:18    554s] 				set cell   [lindex $args 0]
[05/05 22:20:18    554s] 				set format [lindex $args 1]
[05/05 22:20:18    554s] 				set file   [lindex $args 2]
[05/05 22:20:18    554s] 				if {$alen==3} {
[05/05 22:20:18    554s] 					return [$cmd $cell $format $file]
[05/05 22:20:18    554s] 				} else {
[05/05 22:20:18    554s] 					set llx [lindex $args 3]
[05/05 22:20:18    554s] 					set lly [lindex $args 4]
[05/05 22:20:18    554s] 					set dx  [lindex $args 5]
[05/05 22:20:18    554s] 					set dy  [lindex $args 6]
[05/05 22:20:18    554s] 					if {[CheckNumber $llx] && [CheckNumber $lly] && [CheckNumber $dx] && [CheckNumber $dy]} {
[05/05 22:20:18    554s] 						return [$cmd $cell $format $file $llx $lly $dx $dy]
[05/05 22:20:18    554s] 					}
[05/05 22:20:18    554s] 				}
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		"mgc_rve_export_netlist" {
[05/05 22:20:18    554s] 			if {[llength $args]==3} {
[05/05 22:20:18    554s] 				set cell [lindex $args 0]
[05/05 22:20:18    554s] 				set format [lindex $args 1]
[05/05 22:20:18    554s] 				set file [lindex $args 2]
[05/05 22:20:18    554s] 				return [$cmd $cell $format $file]
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 		"mgc_rve_import" {
[05/05 22:20:18    554s] 			if {[llength $args]==2} {
[05/05 22:20:18    554s] 				set fname [lindex $args 0]
[05/05 22:20:18    554s] 				set lname [lindex $args 1]
[05/05 22:20:18    554s] 				return [$cmd $fname $lname]
[05/05 22:20:18    554s] 			}
[05/05 22:20:18    554s] 		}
[05/05 22:20:18    554s]         "mgc_rve_send_protocol_version" {
[05/05 22:20:18    554s]             if {[llength $args] == 4} {
[05/05 22:20:18    554s]                 foreach {prot_ver host port display} $args {break}
[05/05 22:20:18    554s]                 return [$cmd $prot_ver $host $port $display]
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         "mgc_rve_run_viewer_code" {
[05/05 22:20:18    554s]             if {[llength $args] > 2} {
[05/05 22:20:18    554s]                 set key [lindex $args 0]
[05/05 22:20:18    554s]                 set viewerType [lindex $args 1]
[05/05 22:20:18    554s]                 return [eval $cmd $key $viewerType [lrange $args 2 end]]
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         "mgc_rve_get_version_for_feature" {
[05/05 22:20:18    554s]             if {[llength $args] == 1} {
[05/05 22:20:18    554s]                 set feature [lindex $args 0]
[05/05 22:20:18    554s]                 return [$cmd $feature]
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	puts stdout "RVE: Rejecting improperly formatted command"
[05/05 22:20:18    554s] 	return 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_get_version_for_feature {feature} {
[05/05 22:20:18    554s]     variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     if {$feature eq "runcode"} {
[05/05 22:20:18    554s]         SendCmdToClient layout_data_ready $vars(runcode_version)
[05/05 22:20:18    554s]     } else {
[05/05 22:20:18    554s]         SendCmdToClient layout_data_ready 0.0
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_run_viewer_code {key viewerType args} {
[05/05 22:20:18    554s]     variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set runMe 0
[05/05 22:20:18    554s]     if {[info exists ::env(MGC_CALIBRE_ALLOW_VIEWER_TRIGGERS)]} {
[05/05 22:20:18    554s]         set runMeStr $::env(MGC_CALIBRE_ALLOW_VIEWER_TRIGGERS)
[05/05 22:20:18    554s]         if {[string toupper $runMeStr] eq "ALWAYS"} {
[05/05 22:20:18    554s]             set runMe 1
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             ShowError "Viewer triggers are not allowed in this Encounter process"
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]     } elseif {[lsearch -exact $vars(CI_trigger_keys) $key] != -1} {
[05/05 22:20:18    554s]         set runMe 1
[05/05 22:20:18    554s]     } else {
[05/05 22:20:18    554s]         ShowError "Viewer triggers are allowed only in Calibre Interactive processes started from Encounter"
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     if {$viewerType eq "schematic"} {
[05/05 22:20:18    554s]         set retCmd schematic_done
[05/05 22:20:18    554s]     } else {
[05/05 22:20:18    554s]         set retCmd layout_done
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     if {$runMe} {
[05/05 22:20:18    554s]         set trigCmd [lindex $args 0]
[05/05 22:20:18    554s]         if {[catch {set result [eval $trigCmd [lrange $args 1 end]]} msg]} {
[05/05 22:20:18    554s]             ShowError "Error while running trigger: $msg"
[05/05 22:20:18    554s]             append retCmd " 0"
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             append retCmd " $result"
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]     } else {
[05/05 22:20:18    554s]         append retCmd " 0"
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     eval SendCmdToClient $retCmd
[05/05 22:20:18    554s]     return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_send_protocol_version {protVersion host port display} {
[05/05 22:20:18    554s]     variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set vars(client_protocol_version) $protVersion
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::getDisplayEnvVar {} {
[05/05 22:20:18    554s]     global env
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set host [info hostname]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     # $env(DISPLAY) :0.0 0:0 verbena:2 :2 are all valid
[05/05 22:20:18    554s]     if { ![info exists env(DISPLAY)] || $env(DISPLAY)=="0:0" } {
[05/05 22:20:18    554s]         set display $host:0.0
[05/05 22:20:18    554s]     } else {
[05/05 22:20:18    554s]         set colon_index [string first ":" $env(DISPLAY)]
[05/05 22:20:18    554s]         if {$colon_index>0} {
[05/05 22:20:18    554s]             set display $env(DISPLAY)
[05/05 22:20:18    554s]         } elseif {$colon_index==0} {
[05/05 22:20:18    554s]             set display $host$env(DISPLAY)
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             # there should be : in the env, e.g. 0.0 is not a valid display, just in case.
[05/05 22:20:18    554s]             set display $host:$env(DISPLAY)
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     return $display
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_rfile {in_fname} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {$vars(RFILE_BUSY)} {
[05/05 22:20:18    554s] 		return 1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(RFILE_BUSY) 1
[05/05 22:20:18    554s]     set vars(got_show_layers) 0
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set fname [string trim $in_fname "\""]
[05/05 22:20:18    554s] 	if {![file readable $fname]} {
[05/05 22:20:18    554s] 		return 1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	incr vars(hl_layer_index)
[05/05 22:20:18    554s] 	if {$vars(hl_layer_index) > $vars(max_hl_layer)} {
[05/05 22:20:18    554s] 		set vars(max_hl_layer) $vars(hl_layer_index)
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	set vars(hl_layer) "$vars(hl_layer_basen)_$vars(hl_layer_index)"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set cval [catch {source -quiet $fname} rval]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(RFILE_BUSY) 0
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {$cval} {
[05/05 22:20:18    554s] 		uimessage_Error . "Error while highlighting:\n$rval"
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set f [open $fname "r"]
[05/05 22:20:18    554s] 	set linecount [ProcessRveFile $f]
[05/05 22:20:18    554s] 	close $f
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {$linecount==0} {return 1}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	ShowError "Format error in file $in_fname at line $linecount."
[05/05 22:20:18    554s] 	return 0
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_delete_markers {{in_cell ""} {in_all 0}} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s]     variable hlTextObjs 
[05/05 22:20:18    554s]     variable hlEdgeObjs 
[05/05 22:20:18    554s]     variable hlPolyObjs
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {![DesignLoaded 1]} {
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	for {set i 0} {$i <= $vars(max_hl_layer)} {incr i} {
[05/05 22:20:18    554s] 		set layer "$vars(hl_layer_basen)_$i"
[05/05 22:20:18    554s] 		deleteCustomLayer $layer
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     catch {array unset hlTextObjs}
[05/05 22:20:18    554s]     catch {array unset hlEdgeObjs}
[05/05 22:20:18    554s]     catch {array unset hlPolyObjs}
[05/05 22:20:18    554s]     array set hlTextObjs {}
[05/05 22:20:18    554s]     array set hlEdgeObjs {}
[05/05 22:20:18    554s]     array set hlPolyObjs {}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {$vars(RFILE_BUSY)} {
[05/05 22:20:18    554s] 		set vars(hl_layer_index) 0
[05/05 22:20:18    554s] 		set vars(hl_layer) "rve_0"
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		set vars(hl_layer_index) 0
[05/05 22:20:18    554s] 		redraw
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_zoom {args} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	if {[llength $args]!=5} {return 0}
[05/05 22:20:18    554s] 	set llx [lindex $args 0]
[05/05 22:20:18    554s] 	set lly [lindex $args 1]
[05/05 22:20:18    554s] 	set urx [lindex $args 2]
[05/05 22:20:18    554s] 	set ury [lindex $args 3]
[05/05 22:20:18    554s] 	set zfactor [lindex $args 4]
[05/05 22:20:18    554s] 	if {$zfactor==0} {
[05/05 22:20:18    554s] 		redraw
[05/05 22:20:18    554s] 		return 1
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	zoomBox $llx $lly $urx $ury
[05/05 22:20:18    554s] 	zoomOut
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_context {cell precision} {
[05/05 22:20:18    554s] 	return [DesignLoaded]
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_highlight_index {index args} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	set vars(hl_layer) "$vars(hl_layer_basen)_${index}"
[05/05 22:20:18    554s] 	if {$index > $vars(max_hl_layer)} {
[05/05 22:20:18    554s] 		set vars(max_hl_layer) $index
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	# DR717379: Difficult to see highlight shapes in EDI by default, custom color is not supported either.
[05/05 22:20:18    554s] 	if { [llength $args]==2 } {
[05/05 22:20:18    554s] 		setLayerPreference $vars(hl_layer) -color [lindex $args 1]
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_incr_highlight_index {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	incr vars(hl_layer_index)
[05/05 22:20:18    554s] 	if {$vars(hl_layer_index) > $vars(max_hl_layer)} {
[05/05 22:20:18    554s] 		set vars(max_hl_layer) $vars(hl_layer_index)
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	set vars(hl_layer) "$vars(hl_layer_basen)_$vars(hl_layer_index)"
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::get_highlight_index {} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	return $vars(hl_layer_index)
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_export_stream {cell filename {llx 0} {lly 0} {dx 0} {dy 0}} {
[05/05 22:20:18    554s] 	return [mgc_enc::_mgc_rve_export_stream $cell $filename $llx $lly $dx $dy]
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::_mgc_rve_export_stream {cell filename {llx 0} {lly 0} {dx 0} {dy 0}} {
[05/05 22:20:18    554s] 	global env
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set exec_ok 1
[05/05 22:20:18    554s] 	if {$vars(showDlgRunTimeGDS) == 1} {
[05/05 22:20:18    554s] 		set exec_ok [SetExportOptions GDS 1]
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	if {$exec_ok == 0} {
[05/05 22:20:18    554s] 		TranscriptMessage "GDS export cancelled by user"
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set cmd "[getExportCmd $filename $vars(exportOptionsGDS)]"
[05/05 22:20:18    554s] 	if { $dx>0 && $dy>0 } {
[05/05 22:20:18    554s] 		set urx [expr $llx + $dx]
[05/05 22:20:18    554s] 		set ury [expr $lly + $dy]
[05/05 22:20:18    554s] 		append cmd " -area {$llx $lly $urx $ury}"
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {[catch {eval $cmd} msg]} {
[05/05 22:20:18    554s] 		TranscriptMessage $msg
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::_mgc_rve_export_def {cell filename} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set exec_ok 1
[05/05 22:20:18    554s] 	if {$vars(showDlgRunTimeDEF) == 1} {
[05/05 22:20:18    554s] 		set exec_ok [SetExportOptions DEF 1]
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	if {$exec_ok == 0} {
[05/05 22:20:18    554s] 		TranscriptMessage "DEF export cancelled by user"
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	set cmd "[getExportDefCmd $filename $vars(exportOptionsDEF)]"
[05/05 22:20:18    554s] 	if {[catch {eval $cmd} msg]} {
[05/05 22:20:18    554s] 		TranscriptMessage $msg
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_export_layout {cell format filename {llx 0} {lly 0} {dx 0} {dy 0}} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(exportFileName) [string trim $filename "\""]
[05/05 22:20:18    554s] 	set format [string trim $format \"]
[05/05 22:20:18    554s] 	if {$format!="GDSII" && $format!="DEF"} {
[05/05 22:20:18    554s] 		mgc_enc::ShowError "Calibre Interactive: Cannot export $format format layout from Encounter."
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	# Innovus defOut doesn't support -area option, but streamOut does
[05/05 22:20:18    554s] 	if { $format!="GDSII" && $dx>0 && $dy>0 } {
[05/05 22:20:18    554s] 		TranscriptMessage "Area export not implemented. Exporting entire design..."
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	if {$format=="GDSII"} {
[05/05 22:20:18    554s] 		SendCmdToClient layout_done [_mgc_rve_export_stream $cell $filename $llx $lly $dx $dy]
[05/05 22:20:18    554s] 	} else {
[05/05 22:20:18    554s] 		SendCmdToClient layout_done [_mgc_rve_export_def $cell $filename]
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::_mgc_rve_export_verilog {cell filename} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set exec_ok 1
[05/05 22:20:18    554s] 	if {$vars(showDlgRunTimeVerilog) == 1} {
[05/05 22:20:18    554s] 		set exec_ok [SetExportOptions Verilog 1]
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	if {$exec_ok == 0} {
[05/05 22:20:18    554s] 		TranscriptMessage "Verilog export cancelled by user"
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	set cmd "[getExportVerilogCmd $filename $vars(exportOptionsVerilog)]"
[05/05 22:20:18    554s] 	if {[catch {eval $cmd} msg]} {
[05/05 22:20:18    554s] 		TranscriptMessage $msg
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::_mgc_rve_export_netlist {cell format filename} {
[05/05 22:20:18    554s] 	if {$format!="VERILOG"} {
[05/05 22:20:18    554s] 		mgc_enc::ShowError "Calibre Interactive: Cannot export $format format netlists from Encounter."
[05/05 22:20:18    554s] 		return 0
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	return [_mgc_rve_export_verilog $cell $filename]
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::mgc_rve_export_netlist {cell format filename} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(exportFileName) [string trim $filename "\""]
[05/05 22:20:18    554s] 	SendCmdToClient schematic_done [_mgc_rve_export_netlist $cell $format $filename]
[05/05 22:20:18    554s] 	return 1
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
