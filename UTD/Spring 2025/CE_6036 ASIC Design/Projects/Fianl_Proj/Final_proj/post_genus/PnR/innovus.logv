[05/05 22:20:18    554s] 	setLayerPreference rve_14 -color violet     -isVisible 1 -isSelectable 1 -lineWidth 5 -stipple none
[05/05 22:20:18    554s] 	setLayerPreference rve_15 -color tan        -isVisible 1 -isSelectable 1 -lineWidth 5 -stipple none
[05/05 22:20:18    554s] }
