[05/05 22:20:18    554s] @namespace eval Calibre::marker_if {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     namespace export mgc_rve_add_start mgc_rve_add_cell       \
[05/05 22:20:18    554s]               mgc_rve_add_rectangle mgc_rve_define_rectangle  \
[05/05 22:20:18    554s]               mgc_rve_add_end                                 \
[05/05 22:20:18    554s]               mra_check                                       \
[05/05 22:20:18    554s]               mra_start             mra_cell                  \
[05/05 22:20:18    554s]               mra_rect              mrd_rect                  \
[05/05 22:20:18    554s]               mra_end                                         \
[05/05 22:20:18    554s]               import_file
[05/05 22:20:18    554s]     namespace import ::Calibre::import_rdb::*
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set         currentCellName         ""
[05/05 22:20:18    554s]     set         currentCheckName        ""
[05/05 22:20:18    554s]     array unset createdCheckTypes
[05/05 22:20:18    554s]     set         currentLayers           [list]
[05/05 22:20:18    554s]     set         currentCheckText        ""
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc register_cell { sticky cell args } {
[05/05 22:20:18    554s]         variable currentCellName
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set curr_init_top_cell [dbCellName [dbgTopCell]]
[05/05 22:20:18    554s]         if { ($curr_init_top_cell ne "") && ($cell ne $curr_init_top_cell) } {
[05/05 22:20:18    554s]             set currentCellName         ""
[05/05 22:20:18    554s]             puts "Error: '$cell' should be opened and set as the top cell."
[05/05 22:20:18    554s]             return ""
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         array unset arguments
[05/05 22:20:18    554s]         array set arguments [::Calibre::import_rdb::ParseArguments $args]
[05/05 22:20:18    554s]         if { [info exists arguments(-precision)] } {
[05/05 22:20:18    554s]           set precision $arguments(-precision)
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]           set precision  1000
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         ::mgc_enc::mgc_rve_context $cell $precision
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $sticky } {
[05/05 22:20:18    554s]             set currentCellName $cell
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         return $cell
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc mgc_rve_add_check_internal { sticky name_pos args } {
[05/05 22:20:18    554s]         variable currentCellName
[05/05 22:20:18    554s]         variable currentCheckName
[05/05 22:20:18    554s]         variable createdCheckTypes
[05/05 22:20:18    554s]         variable currentLayers
[05/05 22:20:18    554s]         variable currentCheckText
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { [llength $args] < 1 } {
[05/05 22:20:18    554s]             return {}
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         array unset arguments
[05/05 22:20:18    554s]         array set arguments [::Calibre::import_rdb::ParseArguments $args]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $name_pos == 1 } {
[05/05 22:20:18    554s]             set cell [join [lindex $args 0]]
[05/05 22:20:18    554s]             set route_view [eval mra_cell ${cell} $args]
[05/05 22:20:18    554s]             if { $route_view eq "" } {
[05/05 22:20:18    554s]                 return {}
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]         } else {   # name_pos <= 0
[05/05 22:20:18    554s]             if { $currentCellName eq "" } {
[05/05 22:20:18    554s]                 puts "Error: cell should be set first."
[05/05 22:20:18    554s]                 return {}
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]             set cell $currentCellName
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $name_pos >= 0 } {
[05/05 22:20:18    554s]             set check [join [lindex $args $name_pos]]
[05/05 22:20:18    554s]         } else {   # name_pos < 0
[05/05 22:20:18    554s]             if { $currentCheckName eq "" } {
[05/05 22:20:18    554s]                 puts "Error: check should be set first."
[05/05 22:20:18    554s]                 return {}
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]             set check $currentCheckName
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set check_type_name [join [list ${cell} ${check}] /]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set check_text   ""
[05/05 22:20:18    554s]         set check_layers [list]
[05/05 22:20:18    554s]         if { [info exists createdCheckTypes(${check_type_name})] } {
[05/05 22:20:18    554s]             set check_text_and_layers $createdCheckTypes(${check_type_name})
[05/05 22:20:18    554s]             set check_text   [lindex check_text_and_layers 0]
[05/05 22:20:18    554s]             set check_layers [lindex check_text_and_layers 1]
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $sticky } {
[05/05 22:20:18    554s]             set currentCheckText $check_text
[05/05 22:20:18    554s]             set currentLayers $check_layers
[05/05 22:20:18    554s]             set currentCheckName ${check}
[05/05 22:20:18    554s]             if { [info exists arguments(-text_desc)] } {
[05/05 22:20:18    554s]                 set currentCheckText $arguments(-text_desc)
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]             if { [info exists arguments(-layer)] } {
[05/05 22:20:18    554s]                 set currentLayers $arguments(-layer)
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]             set createdCheckTypes($check_type_name) [list $currentCheckText $currentLayers]
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         return $check_layers
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc mgc_rve_add_clear { {cell ""} } {
[05/05 22:20:18    554s]         variable currentCellName
[05/05 22:20:18    554s]         variable currentCheckName
[05/05 22:20:18    554s]         variable createdCheckTypes
[05/05 22:20:18    554s]         variable currentLayers
[05/05 22:20:18    554s]         variable currentCheckText
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set         currentCellName     ""
[05/05 22:20:18    554s]         set         currentCheckName     ""
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         array unset createdCheckTypes
[05/05 22:20:18    554s]         array set   createdCheckTypes       {}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set         currentLayers           [list]
[05/05 22:20:18    554s]         set         currentCheckText        ""
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         return $cell
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc mgc_rve_add_drc_error { de_pos shape args } {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         variable currentCellName
[05/05 22:20:18    554s]         variable currentCheckName
[05/05 22:20:18    554s]         variable createdCheckTypes
[05/05 22:20:18    554s]         variable currentLayers
[05/05 22:20:18    554s]         variable currentCheckText
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { [llength $args] < 1 } {
[05/05 22:20:18    554s]             puts "Error: invalid parameters for creating Encounter DRC Error: mgc_rve_add_rectangle $args."
[05/05 22:20:18    554s]             return {}
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $currentCellName eq "" } {
[05/05 22:20:18    554s]             return 0
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $de_pos >= 1 } {
[05/05 22:20:18    554s]             set cell [join [lindex $args 0]]
[05/05 22:20:18    554s]             set drc_layout_cell [eval mra_cell ${cell} $args]
[05/05 22:20:18    554s]             if { $drc_layout_cell eq "" } {
[05/05 22:20:18    554s]                 return {}
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             set cell $currentCellName
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $de_pos >= 2 } {
[05/05 22:20:18    554s]             set check [join [lindex $args 1]]
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             set check $currentCheckName
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         array unset arguments
[05/05 22:20:18    554s]         array set arguments [::Calibre::import_rdb::ParseArguments $args]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set layers {}
[05/05 22:20:18    554s]         if { [info exists arguments(-layer)] } {
[05/05 22:20:18    554s]             set layers $arguments(-layer)
[05/05 22:20:18    554s]         } elseif { [llength $currentLayers] != 0 } {
[05/05 22:20:18    554s]             set layers $currentLayers
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set drc_info ""
[05/05 22:20:18    554s]         if { [info exists arguments(-info)] } {
[05/05 22:20:18    554s]             set drc_info $arguments(-info)
[05/05 22:20:18    554s]         } elseif { $currentCheckText ne "" } {
[05/05 22:20:18    554s]             set drc_info [list $currentCheckText]
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set edi_com [list createMarker -type Calibre -subtype ${check}]
[05/05 22:20:18    554s]         if { $drc_info ne "" } {
[05/05 22:20:18    554s]             lappend edi_com -desc $drc_info
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set rects [lindex $args [expr {$de_pos + 1}]]
[05/05 22:20:18    554s]         set count 0
[05/05 22:20:18    554s]         foreach rect $rects {
[05/05 22:20:18    554s]             set edi_com_exe $edi_com
[05/05 22:20:18    554s]             lappend edi_com_exe $shape [join $rect]
[05/05 22:20:18    554s]             if { [llength $layers] != 0 } {
[05/05 22:20:18    554s]                 foreach layer $layers {
[05/05 22:20:18    554s]                     set edi_com_exe_rect $edi_com_exe
[05/05 22:20:18    554s]                     lappend edi_com_exe_rect -layer $layer
[05/05 22:20:18    554s]                     incr count
[05/05 22:20:18    554s]                     eval $edi_com_exe_rect
[05/05 22:20:18    554s]                 }
[05/05 22:20:18    554s]             } else {
[05/05 22:20:18    554s]                 incr count
[05/05 22:20:18    554s]                 eval $edi_com_exe
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         return $count
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc mra_start { {cell ""} } {
[05/05 22:20:18    554s]         return [mgc_rve_add_clear]
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     interp alias {} mgc_rve_add_start {} mra_start
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc mra_cell { cell args } {
[05/05 22:20:18    554s]         set drc_layout_cell [eval register_cell true ${cell} $args]
[05/05 22:20:18    554s]         return $drc_layout_cell
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     interp alias {} mgc_rve_add_cell {} mra_cell
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc mra_check { args } {
[05/05 22:20:18    554s]         set layers [eval mgc_rve_add_check_internal true 0 $args]
[05/05 22:20:18    554s]         return $layers
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     interp alias {} mgc_rve_add_check {} mra_check
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc mrd_check { args } {
[05/05 22:20:18    554s]         set layers [eval mgc_rve_add_check_internal true 1 $args]
[05/05 22:20:18    554s]         return $layers
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     interp alias {} mgc_rve_define_check {} mrd_check
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc mra_rect { args } {
[05/05 22:20:18    554s]         return [eval mgc_rve_add_drc_error -1 -bbox $args]
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     interp alias {} mgc_rve_add_rectangle {} mra_rect
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc mrd_rect { args } {
[05/05 22:20:18    554s]         return [eval mgc_rve_add_drc_error 2 -bbox $args]
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     interp alias {} mgc_rve_define_rectangle {} mrd_rect
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc mra_end { {cell ""} } {
[05/05 22:20:18    554s]         return [mgc_rve_add_clear]
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     interp alias {} mgc_rve_add_end {} mra_end
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc import_file { fileName } {
[05/05 22:20:18    554s]       mra_start
[05/05 22:20:18    554s]       if {[catch {source $fileName}]} {
[05/05 22:20:18    554s]       	return 0
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s]       mra_end
[05/05 22:20:18    554s]       return 1
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @namespace eval Calibre::route_if {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     namespace export mgc_rve_add_start      mgc_rve_add_cell         \
[05/05 22:20:18    554s]                      mgc_rve_add_check      mgc_rve_define_check     \
