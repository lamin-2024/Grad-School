[05/05 22:20:18    554s]     proc mgc_rve_add_check_internal { sticky name_pos args } {
[05/05 22:20:18    554s]         variable createdCheckLayers
[05/05 22:20:18    554s]         variable currentCellName
[05/05 22:20:18    554s]         variable currentCheckName
[05/05 22:20:18    554s]         variable createdCheckCount
[05/05 22:20:18    554s]         variable currentLayers
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { [llength $args] < 1 } {
[05/05 22:20:18    554s]             return {}
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         array unset arguments
[05/05 22:20:18    554s]         array set arguments [::Calibre::import_rdb::ParseArguments $args]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { [info exists arguments(-text_desc)] } {
[05/05 22:20:18    554s]           set text_desc $arguments(-text_desc)
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]           set text_desc  ""
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $name_pos == 1 } {
[05/05 22:20:18    554s] 	        set cell [join [lindex $args 0]]
[05/05 22:20:18    554s] 	        set drc_cell [eval mgc_rve_open_cell $sticky ${cell} $args]
[05/05 22:20:18    554s] 	        if { $drc_cell eq "" } {
[05/05 22:20:18    554s] 	            return {}
[05/05 22:20:18    554s] 	        }
[05/05 22:20:18    554s]     	} else {   # name_pos <= 0
[05/05 22:20:18    554s]             if { $currentCellName == "" } {
[05/05 22:20:18    554s] 	            puts "Error: cell has not been defined."
[05/05 22:20:18    554s] 	            return {}
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]             set cell $currentCellName
[05/05 22:20:18    554s]     	}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $name_pos >= 0 } {
[05/05 22:20:18    554s]             set check [join [lindex $args $name_pos]]
[05/05 22:20:18    554s]         } else {   # name_pos < 0
[05/05 22:20:18    554s]             if { $currentCheckName eq "" } {
[05/05 22:20:18    554s]                 puts "Error: check should be set first."
[05/05 22:20:18    554s]                 return {}
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]             set check $currentCheckName
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set check_type_name [join [list ${cell} ${check}] /]
[05/05 22:20:18    554s]         if { [info exists createdCheckLayers(${check_type_name})] } {
[05/05 22:20:18    554s]             set check_layers $createdCheckTypes(${check_type_name})
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             set createdCheckCount(${check_type_name}) 0
[05/05 22:20:18    554s]             set check_layers [list]
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $sticky } {
[05/05 22:20:18    554s]             set currentLayers $check_layers
[05/05 22:20:18    554s]             set currentCheckName ${check}
[05/05 22:20:18    554s]             if { [info exists arguments(-layer)] } {
[05/05 22:20:18    554s]                 set currentLayers $arguments(-layer)
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]             set createdCheckLayers(${check_type_name}) $currentLayers
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         return [list ${cell} ${check}]
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc mgc_rve_add_route_blockages { shape coords_pos breakup args } {
[05/05 22:20:18    554s]         variable currentCellName
[05/05 22:20:18    554s]         variable currentCheckName
[05/05 22:20:18    554s]         variable createdCheckCount
[05/05 22:20:18    554s]         variable currentLayers
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { [llength $args] < 1 } {
[05/05 22:20:18    554s]             puts "Error: invalid parameters for creating Encounter route blockage: mgc_rve_add_rectangle/polygon $args."
[05/05 22:20:18    554s]             return {}
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]        	set check_name_pos [expr {$coords_pos - 2}]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $check_name_pos >= 0 } {
[05/05 22:20:18    554s]             set cell_and_check [eval mgc_rve_add_check_internal false $check_name_pos $args]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]             if { [llength $cell_and_check] <= 1 } {
[05/05 22:20:18    554s]                 return {}
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]             set cell [lindex $cell_and_check 0]
[05/05 22:20:18    554s]             set checkName       [lindex $cell_and_check 1]
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             set cell            $currentCellName
[05/05 22:20:18    554s]             set checkName       $currentCheckName
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $cell eq "" } {
[05/05 22:20:18    554s]             return {}
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $checkName eq "" } {
[05/05 22:20:18    554s]             puts "Error: check should've been set first."
[05/05 22:20:18    554s]             return {}
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         array unset arguments
[05/05 22:20:18    554s]         array set arguments [::Calibre::import_rdb::ParseArguments $args]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { [info exists arguments(-layer)] } {
[05/05 22:20:18    554s]             set layers $arguments(-layer)
[05/05 22:20:18    554s]         } elseif { [llength $currentLayers] != 0 } {
[05/05 22:20:18    554s]             set layers $currentLayers
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             puts "Error: need -layer parameter to create route blockage '[lindex $args $coords_pos]'."
[05/05 22:20:18    554s]             return {}
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $breakup } {
[05/05 22:20:18    554s]             set coords [lindex $args $coords_pos]
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             set coords [list [lindex $args $coords_pos]]
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set rb_name_pos [expr {$coords_pos - 1}]
[05/05 22:20:18    554s]         if { $rb_name_pos >= 0 } {
[05/05 22:20:18    554s]             set rb_name [lindex $args $rb_name_pos]
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             set rb_name "mgc_rve_check"
[05/05 22:20:18    554s]             append rb_name _${cell}
[05/05 22:20:18    554s]             append rb_name _${checkName}
[05/05 22:20:18    554s]             foreach layer $layers {
[05/05 22:20:18    554s]                 append rb_name _${layer}
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]             set check_type_name [join [list ${cell} ${checkName}] /]
[05/05 22:20:18    554s]             append rb_name _$createdCheckCount(${check_type_name})
[05/05 22:20:18    554s]             incr createdCheckCount(${check_type_name})
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set edi_com [list createRouteBlk -layer $layers]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set extra_name ""
[05/05 22:20:18    554s]         if { [llength $coords] > 1 } {
[05/05 22:20:18    554s]             set extra_name "_"
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set count 0
[05/05 22:20:18    554s]         set retVal {}
[05/05 22:20:18    554s]         foreach coord $coords {
[05/05 22:20:18    554s]             set edi_com_exe $edi_com
[05/05 22:20:18    554s]             lappend edi_com_exe $shape [join [join $coord]]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]             set rb_name_exe $rb_name
[05/05 22:20:18    554s]             if { $extra_name ne "" } {
[05/05 22:20:18    554s]                 append rb_name_exe $extra_name $count
[05/05 22:20:18    554s]                 incr count
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]             lappend edi_com_exe -name $rb_name_exe
[05/05 22:20:18    554s]             lappend retVal [eval $edi_com_exe]
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         return $retVal
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc mra_start { {cell ""} args } {
[05/05 22:20:18    554s]         mgc_rve_add_clear
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         set drc_cell ""
[05/05 22:20:18    554s]         if { $cell ne "" } {
[05/05 22:20:18    554s]         	set drc_cell [eval mgc_rve_open_cell true ${cell} $args]
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         return $drc_cell
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     interp alias {} mgc_rve_add_start {} mra_start
[05/05 22:20:18    554s] 
