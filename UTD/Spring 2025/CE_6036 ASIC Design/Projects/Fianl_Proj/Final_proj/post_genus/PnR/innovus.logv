[05/05 22:20:18    554s] # Here starts several procs to support user customization of the Calibre menu.
[05/05 22:20:18    554s] @proc mgc_enc::setMenuCmds {menu_cmds} {
[05/05 22:20:18    554s]     variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set vars(menuCmds) $menu_cmds
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::getMenuCmds {} {
[05/05 22:20:18    554s]     variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     return $vars(menuCmds)
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::getAllCalibreMenuCmds {} {
[05/05 22:20:18    554s]     variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set ret_list [list]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     foreach m $vars(menuCmds) {
[05/05 22:20:18    554s]         if {[lindex $m 0] eq "command"} {
[05/05 22:20:18    554s]             set label [lindex $m 1]
[05/05 22:20:18    554s]             if {$label ne ""} {
[05/05 22:20:18    554s]                 append label "/"
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]             append label [lindex $m 2]
[05/05 22:20:18    554s]             set cmd [lindex $m 6]
[05/05 22:20:18    554s]             lappend ret_list [list $label $cmd]
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     return $ret_list
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::applyCustomMenu {commonMenuFile encMenuFile} {
[05/05 22:20:18    554s]     global env
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set tclsh [file join $env(MGC_HOME) bin tclsh]
[05/05 22:20:18    554s]     set custom_parser [file join $env(MGC_HOME) shared pkgs icv tools custom custom_menu.tcl]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set outPath [file join [getTempDir] encInp.[pid].customMenu]
[05/05 22:20:18    554s]     set readOK 1
[05/05 22:20:18    554s]     if {[catch {exec $tclsh $custom_parser -common_file $commonMenuFile -viewer_file $encMenuFile -output_file $outPath} msg]} {
[05/05 22:20:18    554s]         regsub {child process exited abnormally} $msg {} msg
[05/05 22:20:18    554s]         puts "\n$msg"
[05/05 22:20:18    554s]         set readOK 0
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set first 1
[05/05 22:20:18    554s]     set menuCmds [list]
[05/05 22:20:18    554s]     set fp [open $outPath r]
[05/05 22:20:18    554s]     while {[gets $fp cmd]!=-1} {
[05/05 22:20:18    554s]         if {$first} {
[05/05 22:20:18    554s]         # Ignore header line.
[05/05 22:20:18    554s]             set first 0
[05/05 22:20:18    554s]             continue
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         set splist [split $cmd ","]
[05/05 22:20:18    554s]         lappend menuCmds $splist
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     close $fp
[05/05 22:20:18    554s]     file delete -force $outPath
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     if {$readOK && [info exists env(MGC_CALIBRE_VIEWER_MENU_CMDS)]} {
[05/05 22:20:18    554s]         puts "Successfully read Calibre menu customization file \"$env(MGC_CALIBRE_VIEWER_MENU_CMDS)\""
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     return $menuCmds
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::runUserCmd {cmdIdx} {
[05/05 22:20:18    554s]     variable userCmds
[05/05 22:20:18    554s]     variable vars
[05/05 22:20:18    554s]     global env
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     if {![info exists userCmds($cmdIdx)]} {
[05/05 22:20:18    554s]         return
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     foreach {label command commandType envVars code} $userCmds($cmdIdx) {break}
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     if {[string match "::CalibreInterface::execCalibre*" $command] || [string match "::CalibreInterface::execNewCalibre*" $command] || $commandType eq "BI"} {
[05/05 22:20:18    554s]         # This is a builtin; call the function.
[05/05 22:20:18    554s]         return [eval $command]
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set curr_cell_name ""
[05/05 22:20:18    554s]     if {$commandType ne "RVE" && $commandType ne "CUSTOM"} {
[05/05 22:20:18    554s]         if {[getTopCell]==0} {
[05/05 22:20:18    554s]             ShowError "No layout exists.\nPlease load a layout before attempting to run $commandType."
[05/05 22:20:18    554s]             return
[05/05 22:20:18    554s]         } else {
[05/05 22:20:18    554s]             set curr_cell_name [getCellName [getTopCell]]
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if {$code ne ""} {
[05/05 22:20:18    554s]         if {[catch {eval $code} msg]} {
[05/05 22:20:18    554s]             ShowError "Problem executing code snippet specified with -code.
[05/05 22:20:18    554s]                 Error message:
[05/05 22:20:18    554s]                 $msg
[05/05 22:20:18    554s]                 "
[05/05 22:20:18    554s]             return
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if {[mgc_enc::CheckEnv] eq ""} {
[05/05 22:20:18    554s]         ShowError "Can't start RVE server"
[05/05 22:20:18    554s]         return
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     # A custom command.
[05/05 22:20:18    554s]     set tool [string tolower $commandType]
[05/05 22:20:18    554s]     set do_trigger 0
[05/05 22:20:18    554s]     set doSetup 0
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     # check if the process was already started (if MGC_CALIBRE_VIEWER_MENU_CMDS_SINGLE_TOOL)
[05/05 22:20:18    554s]     set fid ""
[05/05 22:20:18    554s]     if { [info exists ::env(MGC_CALIBRE_VIEWER_MENU_CMDS_SINGLE_TOOL)] &&
[05/05 22:20:18    554s]         $::env(MGC_CALIBRE_VIEWER_MENU_CMDS_SINGLE_TOOL) ne "0" } {
[05/05 22:20:18    554s]         set fid [CheckGUI $curr_cell_name $tool $command]
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     if {$fid eq ""} {
[05/05 22:20:18    554s]         # We need to start the process.
[05/05 22:20:18    554s]         # we will call rdrc_SetupDRC not rdrc_RunDRC (or lvs, etc..)
[05/05 22:20:18    554s]         set doSetup 1
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         # Write a script to setup the environment
[05/05 22:20:18    554s]         set scriptPath [file join [getTempDir] encounterScript.[pid].$commandType]
[05/05 22:20:18    554s]         if {[catch {set wf [open $scriptPath w]} msg]} {
[05/05 22:20:18    554s]             ShowError "Cannot create temporary file $scriptPath.
[05/05 22:20:18    554s] Error message:
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] $msg
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] "
[05/05 22:20:18    554s]             return
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         puts $wf "#!/bin/sh"
[05/05 22:20:18    554s]         foreach envpair $envVars {
[05/05 22:20:18    554s]             if {[string match "=*" $envpair]} {
[05/05 22:20:18    554s]             # We want to unset the envar.
[05/05 22:20:18    554s]                 regsub {=} $envpair {} envarname
[05/05 22:20:18    554s]                 puts $wf "unset $envarname"
[05/05 22:20:18    554s]             } else {
[05/05 22:20:18    554s]             # We want to set the envar.
[05/05 22:20:18    554s]                 regsub {=.*} $envpair {} exportvar
[05/05 22:20:18    554s]                 puts $wf $envpair
[05/05 22:20:18    554s]                 puts $wf "export $exportvar"
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         puts $wf ""
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         # Standard socket server stuff.
[05/05 22:20:18    554s]         puts $wf "MGC_CGI_MONITOR_STDIN=1"
[05/05 22:20:18    554s]         puts $wf "export MGC_CGI_MONITOR_STDIN"
[05/05 22:20:18    554s]         puts $wf "MGC_CALIBRE_LAYOUT_SERVER_NAME=Cadence:Encounter"
[05/05 22:20:18    554s]         puts $wf "export MGC_CALIBRE_LAYOUT_SERVER_NAME"
[05/05 22:20:18    554s]         set sockNum [GetDefaultSocket]
[05/05 22:20:18    554s]         foreach {host port} $sockNum {break}
[05/05 22:20:18    554s]         puts $wf "MGC_CALIBRE_LAYOUT_SERVER=$host:$port"
[05/05 22:20:18    554s]         puts $wf "export MGC_CALIBRE_LAYOUT_SERVER"
[05/05 22:20:18    554s]         puts $wf "MGC_RVE_HILIGHT_SHORT_TEXT_CMDS=1"
[05/05 22:20:18    554s]         puts $wf "export MGC_RVE_HILIGHT_SHORT_TEXT_CMDS"
[05/05 22:20:18    554s]         puts $wf ""
[05/05 22:20:18    554s]         puts $wf $command
[05/05 22:20:18    554s]         if {![info exists env(MGC_CALIBRE_ECHO_VIEWER_MENU_CMDS)]} {
[05/05 22:20:18    554s]             puts $wf "rm $scriptPath"
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         close $wf
[05/05 22:20:18    554s]         file attributes $scriptPath -permissions 0777
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if {$commandType ne "RVE" && $commandType ne "CUSTOM"} {
[05/05 22:20:18    554s]             if {[namespace eval "::" {info procs "mgc_start_calibre_trigger"}] ne ""} {
[05/05 22:20:18    554s]                 set do_trigger 1
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]         if {$do_trigger} {
[05/05 22:20:18    554s]             mgc_start_calibre_trigger $tool $curr_cell_name
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if {[catch {set fid [open "| $scriptPath 2>@ stdout" "r+"]} cmsg]==0} {
[05/05 22:20:18    554s]             fconfigure $fid -blocking 0 -buffering line
[05/05 22:20:18    554s]             if {$commandType eq "RVE"} {
[05/05 22:20:18    554s]                 fileevent $fid readable [list mgc_enc::ReadRVE $fid]
[05/05 22:20:18    554s]                 lappend vars(rve_fids) $fid
[05/05 22:20:18    554s]             } elseif {$commandType ne "CUSTOM"} {
[05/05 22:20:18    554s]                 fileevent $fid readable [list mgc_enc::ReadGUI $fid $curr_cell_name $tool $command]
[05/05 22:20:18    554s]                 # See CheckGUI. Need to remember the fid by tool, command, and cell for a custom command
[05/05 22:20:18    554s]                 set vars(${tool},${command},${curr_cell_name}) $fid
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if {[info exists env(MGC_CALIBRE_ECHO_VIEWER_MENU_CMDS)]} {
[05/05 22:20:18    554s]             puts "Starting verification menu user command $scriptPath"
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     # Now the process was either already started, or just started.  For CI we need to send
[05/05 22:20:18    554s]     # either rdrc_SetupDRC or rdrc_RunDRC (or lvs, etc..). The rdrc_RunDRC cmd will also pop the CI window
[05/05 22:20:18    554s]     if {$fid ne ""} {
[05/05 22:20:18    554s]         if {$commandType ne "CUSTOM"} {
[05/05 22:20:18    554s]             #set alib [get_attribute $lib_obj full_name]
[05/05 22:20:18    554s]             #set aview [get_attribute $lib_obj view_name]
[05/05 22:20:18    554s]             if {$doSetup} {
[05/05 22:20:18    554s]                 set rcmd r${tool}_Setup$commandType
[05/05 22:20:18    554s]             } else {
[05/05 22:20:18    554s]                 set rcmd r${tool}_Run$commandType
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]             puts $fid "$rcmd $curr_cell_name"
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::getUserCmds {} {
[05/05 22:20:18    554s]     variable userCmds
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set ret_list [list]
[05/05 22:20:18    554s]     foreach key [lsort -dict [array names userCmds]] {
[05/05 22:20:18    554s]         regsub -all {&} $userCmds($key) {} value
[05/05 22:20:18    554s]         lappend ret_list "$key $value"
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     return $ret_list
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::createUserMenuCommand {cmd label commandType command envVars code} {
[05/05 22:20:18    554s]     variable userCmds
[05/05 22:20:18    554s]     variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     set idx $vars(userCmdIdx)
[05/05 22:20:18    554s]     incr vars(userCmdIdx)
[05/05 22:20:18    554s]     set userCmds($idx) [list $label $command $commandType $envVars $code]
[05/05 22:20:18    554s]     lappend cmd -command [list mgc_enc::runUserCmd $idx]
[05/05 22:20:18    554s]     eval $cmd
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc getTempDir {} {
[05/05 22:20:18    554s]     set tempDir ""
[05/05 22:20:18    554s]     if { [info exists ::env(MGC_TMPDIR)] && [file isdirectory $::env(MGC_TMPDIR)] && [file writable $::env(MGC_TMPDIR)] } {
[05/05 22:20:18    554s]         set tempDir $::env(MGC_TMPDIR)
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if { $tempDir eq "" && [info exists ::env(MGC_HOME)] && [file exists $::env(MGC_HOME)] } {
[05/05 22:20:18    554s]         set path [file join $::env(MGC_HOME) tmp]
[05/05 22:20:18    554s]         if { [file isdirectory $path] && [file writable $path] } {
[05/05 22:20:18    554s]             set tempDir $path
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if { $tempDir eq "" && [file exists "/usr/tmp"] && [file writable "/usr/tmp"]} {
[05/05 22:20:18    554s]         set tempDir "/usr/tmp"
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if { $tempDir eq "" && [info exists ::env(HOME)] } {
[05/05 22:20:18    554s]         if { [file exists $::env(HOME)] && [file writable $::env(HOME)] } {
[05/05 22:20:18    554s]             set tempDir $::env(HOME)
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     if { $tempDir eq "" && [file writable "."] } {
[05/05 22:20:18    554s]         set tempDir "."
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s]     return $tempDir
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
