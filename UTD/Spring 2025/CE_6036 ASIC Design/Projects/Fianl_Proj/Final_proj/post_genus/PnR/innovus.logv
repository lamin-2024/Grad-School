[05/05 22:20:18    554s] @namespace eval Calibre {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     namespace export convert_to_drc_errors convert_to_route_blockages import_drc_errors import_route_blockages
[05/05 22:20:18    554s]     namespace import ::Calibre::import_rdb::*
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc import_drc_errors { fileName } {
[05/05 22:20:18    554s]         return [::Calibre::marker_if::import_file $fileName]
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc import_route_blockages { fileName } {
[05/05 22:20:18    554s]         return [::Calibre::route_if::import_file $fileName]
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc convert_rdb { import_proc args } {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       set calibre "$::env(MGC_HOME)/bin/calibre"
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       set rve_com [list $calibre -rve]
[05/05 22:20:18    554s]       lappend rve_com [join $args]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       array unset arguments
[05/05 22:20:18    554s]       array set arguments [::Calibre::import_rdb::ParseArguments $args]
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       set to_import_file ""
[05/05 22:20:18    554s]       if { ![info exists arguments(-output_file)] } {
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { [info exists ::env(MGC_TMPDIR)] } {
[05/05 22:20:18    554s]           if { [file exists $::env(MGC_TMPDIR)] } {
[05/05 22:20:18    554s]             set to_import_file $::env(MGC_TMPDIR)
[05/05 22:20:18    554s]           }
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $to_import_file eq "" && [info exists ::env(MGC_HOME)] } {
[05/05 22:20:18    554s]           if { [file exists $::env(MGC_HOME)] } {
[05/05 22:20:18    554s]             set to_import_file $::env(MGC_HOME)
[05/05 22:20:18    554s]             set to_import_file "$to_import_file/tmp"
[05/05 22:20:18    554s]             if { ![file exists $to_import_file] } {
[05/05 22:20:18    554s]               set to_import_file ""
[05/05 22:20:18    554s]             }
[05/05 22:20:18    554s]           }
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $to_import_file eq "" && [file exists "/usr/tmp"] } {
[05/05 22:20:18    554s]           set to_import_file "/usr/tmp"
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         if { $to_import_file eq "" } {
[05/05 22:20:18    554s]           set to_import_file "."
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]         # Temporary file for storing Stuttgard commands
[05/05 22:20:18    554s]         set to_import_file "$to_import_file/mgc_rve_rdb[pid]"
[05/05 22:20:18    554s]         lappend rve_com -output_file $to_import_file
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       # lappend rve_com -no_command_in_transcript
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       # Run RVE
[05/05 22:20:18    554s]       set rveStatus [catch {eval exec $rve_com} result]
[05/05 22:20:18    554s]       puts $result
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       if { $rveStatus ne 0 } {
[05/05 22:20:18    554s]         puts "\nConversion failed.\n"
[05/05 22:20:18    554s]         return 1
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       if { $to_import_file eq "" } {
[05/05 22:20:18    554s]         puts "RDB conversion successful."
[05/05 22:20:18    554s]         return 0
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       set retStatus [catch {eval $import_proc $to_import_file} result]
[05/05 22:20:18    554s]       if { $retStatus ne 0 } {
[05/05 22:20:18    554s]       	puts $result
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       if { ($to_import_file ne "") && [file exists $to_import_file] } {
[05/05 22:20:18    554s]         if { (![info exists ::env(MGC_RVE_HILIGHT_DEBUG)]) || \
[05/05 22:20:18    554s]              ($::env(MGC_RVE_HILIGHT_DEBUG) == 0) } {
[05/05 22:20:18    554s]           file delete $to_import_file
[05/05 22:20:18    554s]         }
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]       return $retStatus
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc convert_to_drc_errors { args } {
[05/05 22:20:18    554s]       puts "\nCommand:  convert_to_drc_errors $args\n"
[05/05 22:20:18    554s]       set retStatus [catch {eval convert_rdb Calibre::import_drc_errors -wrapper ::Calibre::convert_to_drc_errors -convert_to edi_drc $args} result]
[05/05 22:20:18    554s]       if { $retStatus ne 0 } {
[05/05 22:20:18    554s]       	return 0
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s]       return 1
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s]     proc convert_to_route_blockages { args } {
[05/05 22:20:18    554s]       puts "\nCommand:  convert_to_route_blockages $args\n"
[05/05 22:20:18    554s]       set retStatus [catch {eval convert_rdb Calibre::import_route_blockages -wrapper ::Calibre::convert_to_route_blockages -convert_to edi_blk $args} result]
[05/05 22:20:18    554s]       if { $retStatus ne 0 } {
[05/05 22:20:18    554s]       	return 0
[05/05 22:20:18    554s]       }
[05/05 22:20:18    554s]       return 1
[05/05 22:20:18    554s]     }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] }
