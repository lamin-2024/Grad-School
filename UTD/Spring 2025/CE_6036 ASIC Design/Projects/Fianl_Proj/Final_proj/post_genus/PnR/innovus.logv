[05/05 22:20:18    554s] @proc mgc_enc::rve_highlight_pattern_changed {i c menuBtn name1 name2 op} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	set sPattern $vars(rve_${i}_pattern)
[05/05 22:20:18    554s] 	$c delete all ;# clean up the canvas
[05/05 22:20:18    554s] 	set cw [$c cget -width]
[05/05 22:20:18    554s] 	set ch [$c cget -height]
[05/05 22:20:18    554s] 	set width 1
[05/05 22:20:18    554s] 	if { [info exists vars(rve_${i}_width)] && [string is integer -strict $vars(rve_${i}_width)] } {
[05/05 22:20:18    554s] 		set width $vars(rve_${i}_width)
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	set color red
[05/05 22:20:18    554s] 	if { [info exists vars(rve_${i}_color)] } {
[05/05 22:20:18    554s] 		set color $vars(rve_${i}_color)
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] 	set item [$c create rectangle 1 1 $cw $ch -width $width -outline $color -fill $color]
[05/05 22:20:18    554s] 	if { [info exists vars(rve_pattern_loaded)] && $sPattern!="Other" } {
[05/05 22:20:18    554s] 		$c itemconfigure $item -stipple ::mgc_enc::Pattern_$sPattern
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::rve_choose_color {i} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 	set color [tk_chooseColor -initialcolor red -title "Choose highlight color for rve_$i"]
[05/05 22:20:18    554s] 	if { $color!="" } {
[05/05 22:20:18    554s] 		set vars(rve_${i}_color) $color
[05/05 22:20:18    554s] 	}
[05/05 22:20:18    554s] }
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] @proc mgc_enc::setExportOptions {type options show_dlg_at_runtime} {
[05/05 22:20:18    554s] 	variable vars
[05/05 22:20:18    554s] 
[05/05 22:20:18    554s] 	set vars(exportOptions$type) $options
[05/05 22:20:18    554s] 	set vars(showDlgRunTime$type) $show_dlg_at_runtime
[05/05 22:20:18    554s] }
